---
import { site } from "../lib/site-data";

const navItems = [
	{ href: "/", label: "Trang chủ" },
	{ href: "/marketplace", label: "Marketplace" },
	{ href: "/tin-tuc", label: "Tin tức" },
	{ href: "/lien-he", label: "Liên hệ" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => {
	if (href === "/") return currentPath === "/";
	return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<a class="skip-link" href="#main-content">Bỏ qua điều hướng</a>
<header class="site-header">
	<div class="nav-shell">
		<a href="/" class="brand" aria-label={`${site.name} homepage`}>
			<span class="brand-mark"><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i></span>
			<span>
				<strong>{site.shortName}</strong>
				<small>Tech Academy</small>
			</span>
		</a>

		<button class="nav-toggle" type="button" aria-label="Mở menu" aria-controls="primary-nav" aria-expanded="false">
			<i class="fa-solid fa-bars" aria-hidden="true"></i>
		</button>

		<nav id="primary-nav" class="primary-nav" aria-label="Điều hướng chính">
			{
				navItems.map((item) => (
					<a
						href={item.href}
						class:list={{ "is-active": isActive(item.href) }}
						aria-current={isActive(item.href) ? "page" : undefined}
					>
						{item.label}
					</a>
				))
			}

			<form class="nav-search mobile-search" action="/marketplace" method="get" role="search">
				<i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
				<input name="q" placeholder="Tìm khóa học, giảng viên..." aria-label="Tìm khóa học" />
			</form>

			<a href="/dang-nhap" class="nav-login mobile-login" data-auth-login-mobile>
				<i class="fa-solid fa-user" aria-hidden="true"></i>
				<span>Đăng nhập</span>
			</a>
			<a href="/dang-ky-tu-van" class="btn btn-primary mobile-cta">Đăng ký tư vấn</a>
		</nav>

		<form class="nav-search desktop-search" action="/marketplace" method="get" role="search">
			<i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
			<input name="q" placeholder="Tìm khóa học, giảng viên..." aria-label="Tìm khóa học" />
		</form>

		<a href="/dang-nhap" class="nav-login desktop-login" data-auth-login>
			<i class="fa-solid fa-user" aria-hidden="true"></i>
			<span>Đăng nhập</span>
		</a>

		<div class="nav-quick-actions" data-auth-actions hidden>
			<a href="/tin-nhan" class="icon-action" aria-label="Tin nhắn">
				<i class="fa-regular fa-message" aria-hidden="true"></i>
			</a>
			<button class="icon-action" type="button" aria-label="Thông báo">
				<i class="fa-regular fa-bell" aria-hidden="true"></i>
				<span class="notify-dot"></span>
			</button>
		</div>

		<div class="nav-profile" data-auth-profile hidden>
			<button class="profile-trigger" type="button" data-profile-trigger aria-haspopup="menu" aria-expanded="false">
				<span class="profile-avatar" data-profile-initial>SV</span>
				<span class="profile-copy">
					<strong data-profile-name>Người dùng</strong>
					<small data-profile-role>Học viên</small>
				</span>
				<i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
			</button>
			<div class="profile-menu" role="menu">
				<a href="/dashboard" role="menuitem">
					<i class="fa-solid fa-table-columns" aria-hidden="true"></i>
					Dashboard
				</a>
				<a href="/tai-khoan" role="menuitem">
					<i class="fa-solid fa-id-card" aria-hidden="true"></i>
					Tài khoản
				</a>
				<a href="/tai-khoan" data-profile-url role="menuitem">
					<i class="fa-solid fa-user" aria-hidden="true"></i>
					Profile
				</a>
				<button type="button" data-nav-logout role="menuitem">
					<i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>
					Đăng xuất
				</button>
			</div>
		</div>

		<a href="/dang-ky-tu-van" class="btn btn-primary nav-cta">Đăng ký tư vấn</a>
	</div>
</header>

<script>
	const navToggle = document.querySelector(".nav-toggle");
	const nav = document.querySelector(".primary-nav");
	const loginLink = document.querySelector("[data-auth-login]");
	const mobileLoginLink = document.querySelector("[data-auth-login-mobile]");
	const profile = document.querySelector("[data-auth-profile]");
	const authActions = document.querySelector("[data-auth-actions]");
	const profileTrigger = document.querySelector("[data-profile-trigger]");
	const profileInitial = document.querySelector("[data-profile-initial]");
	const profileName = document.querySelector("[data-profile-name]");
	const profileRole = document.querySelector("[data-profile-role]");
	const profileUrl = document.querySelector("[data-profile-url]");
	const logoutButton = document.querySelector("[data-nav-logout]");

	if (navToggle instanceof HTMLButtonElement && nav instanceof HTMLElement) {
		navToggle.addEventListener("click", () => {
			nav.classList.toggle("is-open");
			navToggle.setAttribute("aria-expanded", String(nav.classList.contains("is-open")));
		});
	}

	function setText(target: Element | null, value: string) {
		if (target instanceof HTMLElement) target.textContent = value;
	}

	function roleLabel(role?: string) {
		if (role === "admin") return "Admin";
		if (role === "instructor") return "Giảng viên";
		return "Học viên";
	}

	function dashboardPath(role?: string) {
		if (role === "admin") return "/admin";
		if (role === "instructor") return "/giang-vien/dashboard";
		return "/hoc-vien/dashboard";
	}

	async function hydrateNavbarUser() {
		const response = await fetch("/api/auth/me", { headers: { Accept: "application/json" } });
		const result = (await response.json()) as {
			user?: {
				id?: string;
				fullName?: string;
				role?: string;
			} | null;
		};

		if (!result.user) return;

		if (loginLink instanceof HTMLElement) loginLink.hidden = true;
		if (mobileLoginLink instanceof HTMLElement) mobileLoginLink.hidden = true;
		if (authActions instanceof HTMLElement) authActions.hidden = false;
		if (profile instanceof HTMLElement) profile.hidden = false;
		setText(profileInitial, (result.user.fullName || "SV").slice(0, 2).toUpperCase());
		setText(profileName, result.user.fullName || "Người dùng");
		setText(profileRole, roleLabel(result.user.role));
		if (profileUrl instanceof HTMLAnchorElement && result.user.id) {
			profileUrl.href = `/ho-so/${result.user.id}`;
		}

		if (profile instanceof HTMLElement) {
			const dashboardLink = profile.querySelector('a[href="/dashboard"]');
			if (dashboardLink instanceof HTMLAnchorElement) dashboardLink.href = dashboardPath(result.user.role);
		}
	}

	if (profileTrigger instanceof HTMLButtonElement && profile instanceof HTMLElement) {
		profileTrigger.addEventListener("click", () => {
			profile.classList.toggle("is-open");
			profileTrigger.setAttribute("aria-expanded", String(profile.classList.contains("is-open")));
		});
	}

	document.addEventListener("click", (event) => {
		if (profile instanceof HTMLElement && !profile.contains(event.target as Node)) {
			profile.classList.remove("is-open");
			if (profileTrigger instanceof HTMLButtonElement) profileTrigger.setAttribute("aria-expanded", "false");
		}
	});

	if (logoutButton instanceof HTMLButtonElement) {
		logoutButton.addEventListener("click", async () => {
			await fetch("/api/auth/logout", { method: "POST" });
			window.location.href = "/";
		});
	}

	hydrateNavbarUser().catch(() => undefined);
</script>

<style>
	.skip-link {
		position: fixed;
		top: 12px;
		left: 12px;
		z-index: 100;
		padding: 10px 12px;
		border-radius: 10px;
		background: var(--ink);
		color: #fff;
		font-weight: 900;
		text-decoration: none;
		transform: translateY(-140%);
		transition: transform 180ms ease;
	}

	.skip-link:focus {
		transform: translateY(0);
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		border-bottom: 1px solid rgb(226 232 240 / 0.88);
		background: rgb(255 255 255 / 0.9);
		backdrop-filter: blur(18px);
	}

	.nav-shell {
		width: min(1360px, calc(100% - 32px));
		min-height: 72px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 11px;
		min-width: 184px;
		color: var(--ink);
		text-decoration: none;
	}

	.brand-mark {
		width: 42px;
		height: 42px;
		display: inline-grid;
		place-items: center;
		border-radius: 14px;
		background: linear-gradient(135deg, var(--primary), var(--secondary));
		color: #fff;
		box-shadow: 0 14px 30px rgb(17 17 17 / 0.14);
	}

	.brand strong,
	.brand small {
		display: block;
		line-height: 1.08;
	}

	.brand strong {
		font-size: 1.05rem;
		letter-spacing: 0;
	}

	.brand small {
		color: var(--muted);
		font-size: 0.76rem;
		font-weight: 800;
	}

	.primary-nav {
		flex: 0 1 auto;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 2px;
	}

	.primary-nav > a,
	.primary-nav > a {
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		padding: 0 12px;
		border-radius: 12px;
		color: #334155;
		font-size: 0.92rem;
		font-weight: 900;
		text-decoration: none;
		white-space: nowrap;
		transition:
			background 180ms ease,
			color 180ms ease;
	}

	.primary-nav > a:hover,
	.primary-nav > a:focus-visible {
		background: rgb(215 53 42 / 0.08);
		color: var(--primary);
	}

	.nav-toggle {
		display: none;
		margin-left: auto;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: #fff;
		color: var(--ink);
		width: 44px;
		height: 44px;
	}

	.nav-search {
		flex: 1;
		min-width: 240px;
		max-width: 360px;
		height: 44px;
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 0 14px;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: #fff;
		color: var(--muted);
		transition:
			border-color 180ms ease,
			box-shadow 180ms ease,
			background 180ms ease;
	}

	.nav-search:focus-within {
		border-color: rgb(215 53 42 / 0.35);
		box-shadow: 0 0 0 4px rgb(215 53 42 / 0.08);
	}

	.nav-search input {
		width: 100%;
		border: 0;
		outline: 0;
		background: transparent;
		color: var(--ink);
		font-size: 0.9rem;
	}

	.mobile-search,
	.mobile-login,
	.mobile-cta {
		display: none;
	}

	.nav-quick-actions {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.icon-action {
		position: relative;
		width: 44px;
		height: 44px;
		display: inline-grid;
		place-items: center;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: #fff;
		color: #334155;
		text-decoration: none;
		cursor: pointer;
		transition:
			transform 180ms ease,
			color 180ms ease,
			border-color 180ms ease,
			box-shadow 180ms ease;
	}

	.icon-action:hover {
		transform: translateY(-2px);
		border-color: rgb(215 53 42 / 0.28);
		color: var(--primary);
		box-shadow: var(--shadow-sm);
	}

	.notify-dot {
		position: absolute;
		top: 9px;
		right: 10px;
		width: 8px;
		height: 8px;
		border: 2px solid #fff;
		border-radius: 999px;
		background: var(--accent);
	}

	.nav-cta,
	.nav-login {
		white-space: nowrap;
	}

	.nav-login {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		min-height: 44px;
		padding: 0 14px;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: #fff;
		color: #334155;
		font-size: 0.92rem;
		font-weight: 900;
		text-decoration: none;
	}

	.nav-login:hover {
		border-color: rgb(215 53 42 / 0.26);
		color: var(--primary);
		box-shadow: var(--shadow-sm);
	}

	.primary-nav .mobile-search,
	.primary-nav .mobile-login,
	.primary-nav .mobile-cta {
		display: none;
	}

	.nav-profile {
		position: relative;
	}

	.profile-trigger {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		min-height: 44px;
		padding: 5px 10px 5px 5px;
		border: 1px solid var(--line);
		border-radius: 16px;
		background: #fff;
		color: #334155;
		cursor: pointer;
	}

	.profile-trigger:hover {
		border-color: rgb(215 53 42 / 0.24);
		box-shadow: var(--shadow-sm);
	}

	.profile-avatar {
		width: 34px;
		height: 34px;
		display: inline-grid;
		place-items: center;
		border-radius: 11px;
		background: linear-gradient(135deg, var(--primary), var(--secondary));
		color: #fff;
		font-size: 0.78rem;
		font-weight: 900;
	}

	.profile-copy {
		display: grid;
		text-align: left;
		line-height: 1.08;
	}

	.profile-copy strong {
		max-width: 130px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-size: 0.9rem;
	}

	.profile-copy small {
		color: var(--muted);
		font-size: 0.72rem;
		font-weight: 800;
	}

	.profile-menu {
		position: absolute;
		top: calc(100% + 10px);
		right: 0;
		width: 226px;
		display: grid;
		gap: 4px;
		padding: 8px;
		border: 1px solid var(--line);
		border-radius: 18px;
		background: #fff;
		box-shadow: var(--shadow-md);
		opacity: 0;
		pointer-events: none;
		transform: translateY(6px);
		transition:
			opacity 160ms ease,
			transform 160ms ease;
	}

	.nav-profile.is-open .profile-menu {
		opacity: 1;
		pointer-events: auto;
		transform: translateY(0);
	}

	.profile-menu a,
	.profile-menu button {
		display: flex;
		align-items: center;
		gap: 10px;
		width: 100%;
		min-height: 40px;
		padding: 0 10px;
		border: 0;
		border-radius: 12px;
		background: transparent;
		color: #334155;
		font-weight: 800;
		text-align: left;
		text-decoration: none;
		cursor: pointer;
	}

	.profile-menu a:hover,
	.profile-menu button:hover {
		background: rgb(215 53 42 / 0.08);
		color: var(--primary);
	}

	@media (max-width: 1240px) {
		.desktop-search {
			display: none;
		}

		.primary-nav > a,
		.primary-nav > a {
			padding: 0 10px;
			font-size: 0.9rem;
		}
	}

	@media (max-width: 1040px) {
		.nav-shell {
			width: min(100% - 28px, 1180px);
			min-height: 70px;
			flex-wrap: wrap;
			padding: 10px 0;
		}

		.nav-toggle {
			display: inline-grid;
			place-items: center;
		}

		.primary-nav {
			order: 10;
			display: none;
			width: 100%;
			align-items: stretch;
			justify-content: start;
			flex-direction: column;
			gap: 4px;
			padding: 12px;
			border: 1px solid var(--line);
			border-radius: 20px;
			background: #fff;
			box-shadow: var(--shadow-sm);
		}

		.primary-nav.is-open {
			display: flex;
		}

		.primary-nav > a,
		.primary-nav > a {
			width: 100%;
			justify-content: space-between;
			padding: 0 8px;
		}

		.primary-nav .mobile-search {
			display: flex;
			width: 100%;
			max-width: none;
			margin-top: 8px;
		}

		.primary-nav .mobile-login,
		.primary-nav .mobile-cta {
			display: inline-flex;
			width: 100%;
			margin-top: 6px;
		}

		.desktop-login,
		.nav-cta,
		.nav-quick-actions {
			display: none;
		}

		.nav-profile {
			margin-left: auto;
		}
	}

	@media (max-width: 640px) {
		.brand {
			min-width: 0;
		}

		.brand small,
		.profile-copy {
			display: none;
		}

		.profile-trigger {
			padding: 5px;
		}

		.profile-menu {
			right: -48px;
		}
	}

	.site-header {
		top: 12px;
		border-bottom: 0;
		background: transparent;
		backdrop-filter: none;
	}

	.nav-shell {
		width: min(1280px, calc(100% - 32px));
		min-height: 66px;
		padding: 8px;
		border: 1px solid rgb(17 17 17 / 0.18);
		border-radius: 10px;
		background: rgb(255 255 255 / 0.86);
		box-shadow: 0 18px 42px rgb(17 17 17 / 0.12);
		backdrop-filter: blur(18px) saturate(130%);
	}

	.brand {
		min-width: 154px;
		padding-right: 6px;
	}

	.brand-mark,
	.profile-avatar,
	.footer-logo span {
		border-radius: 8px;
		background: #111111;
		box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14);
	}

	.brand strong {
		color: var(--ink);
		font-weight: 900;
	}

	.brand small {
		color: var(--primary);
		font-family: var(--font-mono);
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.primary-nav > a,
	.nav-login,
	.icon-action,
	.profile-trigger,
	.nav-toggle {
		border-radius: 6px;
	}

	.primary-nav > a {
		color: var(--ink-soft);
	}

	.primary-nav > a:hover,
	.primary-nav > a:focus-visible {
		background: #111111;
		color: #fff;
	}

	.primary-nav > a.is-active {
		background: var(--primary);
		color: #fff;
	}

	.nav-search,
	.nav-login,
	.icon-action,
	.profile-trigger,
	.profile-menu {
		border-color: rgb(17 17 17 / 0.16);
		background: rgb(255 255 255 / 0.78);
	}

	.nav-search:focus-within {
		border-color: var(--primary);
		box-shadow: 0 0 0 4px rgb(215 53 42 / 0.12);
	}

	.icon-action:hover,
	.nav-login:hover,
	.profile-trigger:hover {
		border-color: rgb(215 53 42 / 0.32);
		color: var(--primary);
		box-shadow: 0 12px 24px rgb(17 17 17 / 0.08);
	}

	.notify-dot {
		border-color: #fff;
		border-radius: 2px;
		background: var(--primary);
	}

	.profile-menu {
		border-radius: 8px;
		box-shadow: 0 18px 42px rgb(17 17 17 / 0.14);
	}

	.profile-menu a,
	.profile-menu button {
		border-radius: 6px;
	}

	.profile-menu a:hover,
	.profile-menu button:hover {
		background: rgb(215 53 42 / 0.08);
		color: var(--primary);
	}

	@media (max-width: 1040px) {
		.site-header {
			top: 8px;
		}

		.nav-shell {
			width: min(100% - 20px, 1180px);
		}

		.primary-nav {
			border-radius: 8px;
			background: rgb(255 255 255 / 0.94);
		}
	}

	@media (max-width: 1320px) {
		.desktop-search {
			display: none;
		}

		.nav-shell {
			width: min(1180px, calc(100% - 24px));
		}
	}

	@media (min-width: 1041px) and (max-width: 1160px) {
		.nav-cta {
			padding-inline: 12px;
		}

		.nav-login span,
		.nav-cta {
			font-size: 0.88rem;
		}
	}
</style>
