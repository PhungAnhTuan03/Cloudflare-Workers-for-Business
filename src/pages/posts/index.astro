---
import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import Layout from "../../layouts/Layout.astro";
import { site } from "../../lib/site-data";

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	status: "published",
	orderBy: { published_at: "desc" },
});

Astro.cache.set(cacheHint);

const formatDate = (date?: Date | null) =>
	date
		? new Intl.DateTimeFormat("vi-VN", {
				day: "2-digit",
				month: "2-digit",
				year: "numeric",
			}).format(date)
		: "Chưa có ngày";
---

<Layout
	title={`Blog & Tin tức - ${site.name}`}
	description="Cập nhật kiến thức, xu hướng công nghệ và hướng dẫn học tập từ Sao Việt Tech Academy."
	canonical={`${site.url}/posts`}
>
	<section class="page-hero">
		<div class="container">
			<span class="page-kicker">
				<i class="fa-solid fa-newspaper" aria-hidden="true"></i>
				Blog CMS
			</span>
			<h1 class="page-title">Bài viết từ hệ thống nội dung EmDash.</h1>
			<p class="page-lead">Nơi đăng các bài hướng dẫn, tin tức đào tạo và nội dung SEO có thể quản trị từ CMS.</p>
		</div>
	</section>

	<section class="section cms-section">
		<div class="container">
			{
				posts.length === 0 ? (
					<div class="empty-state">
						<div>
							<strong>Chưa có bài viết nào.</strong>
							<p>Hãy tạo bài viết trong EmDash Admin để nội dung xuất hiện tại đây.</p>
							<a class="btn btn-primary" href="/_emdash/admin">Mở EmDash Admin</a>
						</div>
					</div>
				) : (
					<div class="cms-card-grid">
						{posts.map((post) => (
							<a href={`/posts/${post.id}`} class="cms-card card">
								{post.data.featured_image ? (
									<div class="cms-image" {...post.edit.featured_image}>
										<Image image={post.data.featured_image} />
									</div>
								) : (
									<div class="cms-image placeholder">
										<i class="fa-solid fa-pen-nib" aria-hidden="true"></i>
									</div>
								)}
								<div class="cms-body">
									<span>{formatDate(post.data.publishedAt)}</span>
									<h2 {...post.edit.title}>{post.data.title}</h2>
									{post.data.excerpt && <p {...post.edit.excerpt}>{post.data.excerpt}</p>}
									<strong>Đọc tiếp <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></strong>
								</div>
							</a>
						))}
					</div>
				)
			}
		</div>
	</section>
</Layout>

<style>
	.cms-card-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 22px;
	}

	.cms-card {
		overflow: hidden;
		color: inherit;
		text-decoration: none;
	}

	.cms-image {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: var(--soft-blue);
	}

	.cms-image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.cms-image.placeholder {
		display: grid;
		place-items: center;
		color: var(--primary);
		font-size: 2rem;
	}

	.cms-body {
		display: grid;
		gap: 10px;
		padding: 18px;
	}

	.cms-body span {
		color: var(--primary);
		font-size: 0.82rem;
		font-weight: 900;
	}

	.cms-body h2 {
		margin: 0;
		font-size: 1.16rem;
		line-height: 1.35;
	}

	.cms-body p {
		margin: 0;
		color: var(--muted);
	}

	.cms-body strong {
		color: var(--primary);
	}

	@media (max-width: 960px) {
		.cms-card-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.cms-card-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
