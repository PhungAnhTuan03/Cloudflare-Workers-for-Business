---
import Layout from "../layouts/Layout.astro";
import { site } from "../lib/site-data";
---

<Layout
	title={`Marketplace khóa học - ${site.name}`}
	description="Marketplace khóa học do giảng viên đăng bán, có tìm kiếm, lọc giá, giỏ hàng và checkout."
	canonical={`${site.url}/marketplace`}
>
	<section class="market-section">
		<div class="container market-container">
			<div class="market-hero-grid">
				<div class="market-hero">
					<span class="page-kicker">
						<i class="fa-solid fa-store" aria-hidden="true"></i>
						Marketplace
					</span>
					<h1>Chọn khóa học online, mua nhanh và học ngay trong dashboard.</h1>
					<p>
						Tìm theo kỹ năng, so sánh học phí, xem khóa học của giảng viên và mở quyền bài giảng, tài liệu,
						nhắn tin riêng sau khi mua.
					</p>
				</div>

				<aside class="market-summary card">
					<div class="summary-icon">
						<i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>
					</div>
					<strong>Học online linh hoạt</strong>
					<p>Khóa học giảng viên đăng bán được lưu trong database và hiển thị ngay tại marketplace.</p>
					<div class="summary-metrics">
						<div>
							<span data-course-count>0</span>
							<small>khóa học</small>
						</div>
						<div>
							<span>24/7</span>
							<small>truy cập</small>
						</div>
					</div>
					<a href="/gio-hang" class="btn btn-secondary">
						<i class="fa-solid fa-cart-shopping" aria-hidden="true"></i>
						Mở giỏ hàng
					</a>
				</aside>
			</div>

			<form class="market-toolbar card" data-market-filter>
				<div class="field search-field">
					<label for="market-q">Tìm khóa học</label>
					<div class="search-input">
						<i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
						<input id="market-q" name="q" type="search" placeholder="Tên khóa học, kỹ năng, giảng viên..." />
					</div>
				</div>
				<div class="field">
					<label for="market-max">Giá tối đa</label>
					<select id="market-max" name="maxPrice">
						<option value="">Tất cả</option>
						<option value="300000">Dưới 300k</option>
						<option value="500000">Dưới 500k</option>
						<option value="1000000">Dưới 1 triệu</option>
					</select>
				</div>
				<div class="field">
					<label for="market-sort">Sắp xếp</label>
					<select id="market-sort" name="sort">
						<option value="newest">Mới nhất</option>
						<option value="price_asc">Giá thấp</option>
						<option value="price_desc">Giá cao</option>
					</select>
				</div>
				<button class="btn btn-primary" type="submit">
					<i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
					Tìm
				</button>
			</form>

			<div class="result-head">
				<div>
					<h2>Khóa học đang bán</h2>
					<p data-market-status>Đang tải khóa học...</p>
				</div>
				<a href="#market-results" class="text-link">Xem kết quả</a>
			</div>

			<div id="market-results" class="market-grid" data-market-courses>
				<div class="skeleton-card"></div>
				<div class="skeleton-card"></div>
				<div class="skeleton-card"></div>
			</div>
		</div>
	</section>
</Layout>

<script>
	const target = document.querySelector("[data-market-courses]");
	const filterForm = document.querySelector("[data-market-filter]");
	const statusTarget = document.querySelector("[data-market-status]");
	const countTarget = document.querySelector("[data-course-count]");

	type Course = {
		public_id: string;
		title: string;
		description: string;
		price: number;
		cover_url?: string | null;
		instructor_public_id: string;
		instructor_name: string;
	};
	type ApiResult = {
		ok?: boolean;
		message?: string;
		courses?: Course[];
	};

	function setText(target: Element | null, value: string) {
		if (target instanceof HTMLElement) target.textContent = value;
	}

	function escapeHtml(value: string) {
		return String(value)
			.replaceAll("&", "&amp;")
			.replaceAll("<", "&lt;")
			.replaceAll(">", "&gt;")
			.replaceAll('"', "&quot;")
			.replaceAll("'", "&#039;");
	}

	function formatCurrency(value: number) {
		return `${Number(value || 0).toLocaleString("vi-VN")}đ`;
	}

	function hydrateFormFromUrl() {
		if (!(filterForm instanceof HTMLFormElement)) return;
		const params = new URLSearchParams(window.location.search);
		for (const [key, value] of params) {
			const field = filterForm.elements.namedItem(key);
			if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement) field.value = value;
		}
	}

	function buildQuery() {
		if (!(filterForm instanceof HTMLFormElement)) return "";
		const params = new URLSearchParams();
		for (const [key, value] of new FormData(filterForm)) {
			if (typeof value === "string" && value.trim()) params.set(key, value.trim());
		}
		return params.toString();
	}

	function renderLoading() {
		if (!(target instanceof HTMLElement)) return;
		target.innerHTML = "<div class='skeleton-card'></div><div class='skeleton-card'></div><div class='skeleton-card'></div>";
		setText(statusTarget, "Đang tải khóa học...");
	}

	function renderEmpty(message = "Chưa có khóa học phù hợp.") {
		if (!(target instanceof HTMLElement)) return;
		target.innerHTML = `
			<div class="market-empty">
				<i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
				<strong>${escapeHtml(message)}</strong>
				<p>Thử đổi từ khóa, bỏ lọc giá hoặc quay lại sau khi giảng viên đăng thêm khóa học mới.</p>
				<a class="btn btn-primary" href="/dang-ky-tu-van">Nhận tư vấn khóa học</a>
			</div>
		`;
	}

	async function addToCart(id: string | null) {
		setText(statusTarget, "Đang thêm khóa học vào giỏ hàng...");
		const response = await fetch("/api/cart", {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify({ courseId: id }),
		});
		const result = (await response.json()) as ApiResult;
		setText(statusTarget, result.message || (response.ok ? "Đã thêm vào giỏ hàng." : "Không thêm được khóa học."));
	}

	async function buyNow(id: string | null) {
		await addToCart(id);
		window.location.href = "/gio-hang";
	}

	function courseCard(course: Course) {
		const title = escapeHtml(course.title);
		const description = escapeHtml(course.description || "Khóa học trực tuyến có bài giảng, tài liệu và hỗ trợ từ giảng viên.");
		const instructor = escapeHtml(course.instructor_name || "Giảng viên Sao Việt");
		const publicId = escapeHtml(course.public_id);
		const instructorId = escapeHtml(course.instructor_public_id);
		const cover = course.cover_url ? escapeHtml(course.cover_url) : "";
		const initials = title
			.split(" ")
			.filter(Boolean)
			.slice(0, 2)
			.map((part) => part.charAt(0))
			.join("")
			.toUpperCase();

		return `
			<article class="market-card">
				<a class="course-cover" href="/khoa-hoc-giang-vien/${publicId}" aria-label="Xem ${title}">
					${
						cover
							? `<img src="${cover}" alt="${title}" loading="lazy" />`
							: `<div class="cover-fallback">
									<div class="cover-code">
										<span>SV</span>
										<strong>${initials || "KH"}</strong>
										<small>online course</small>
									</div>
								</div>`
					}
					<span>Đang bán</span>
				</a>
				<div class="market-card-body">
					<div class="course-topline">
						<a class="instructor-link" href="/ho-so/${instructorId}">
							<i class="fa-solid fa-chalkboard-user" aria-hidden="true"></i>
							${instructor}
						</a>
						<span>Course ID ${publicId.slice(-6).toUpperCase()}</span>
					</div>
					<h2><a href="/khoa-hoc-giang-vien/${publicId}">${title}</a></h2>
					<p class="course-description">${description}</p>
					<div class="course-facts">
						<small><i class="fa-solid fa-file-lines" aria-hidden="true"></i> Có tài liệu</small>
						<small><i class="fa-solid fa-message" aria-hidden="true"></i> Nhắn tin riêng</small>
						<small><i class="fa-solid fa-lock-open" aria-hidden="true"></i> Mở sau mua</small>
					</div>
					<div class="course-purchase">
						<div>
							<span>Học phí</span>
							<strong>${formatCurrency(course.price)}</strong>
						</div>
						<a href="/khoa-hoc-giang-vien/${publicId}">Chi tiết</a>
					</div>
					<div class="market-actions">
						<button class="btn btn-secondary" data-cart="${publicId}">Thêm giỏ</button>
						<button class="btn btn-accent" data-buy="${publicId}">Mua ngay</button>
					</div>
				</div>
			</article>
		`;
	}

	async function loadCourses() {
		renderLoading();
		const query = buildQuery();
		const response = await fetch(`/api/marketplace/courses${query ? `?${query}` : ""}`);
		const result = (await response.json()) as ApiResult;
		const courses = result.courses || [];

		if (!(target instanceof HTMLElement)) return;
		if (!response.ok || !result.ok) {
			setText(countTarget, "0");
			setText(statusTarget, result.message || "Không tải được khóa học.");
			renderEmpty(result.message || "Không tải được khóa học.");
			return;
		}

		setText(countTarget, String(courses.length));
		setText(statusTarget, courses.length ? `${courses.length} khóa học phù hợp với bộ lọc hiện tại.` : "Không có khóa học phù hợp.");

		if (!courses.length) {
			renderEmpty();
			return;
		}

		target.innerHTML = courses.map(courseCard).join("");

		for (const button of document.querySelectorAll("[data-cart]")) {
			if (!(button instanceof HTMLButtonElement)) continue;
			button.addEventListener("click", () => addToCart(button.getAttribute("data-cart")));
		}

		for (const button of document.querySelectorAll("[data-buy]")) {
			if (!(button instanceof HTMLButtonElement)) continue;
			button.addEventListener("click", () => buyNow(button.getAttribute("data-buy")));
		}
	}

	if (filterForm instanceof HTMLFormElement) {
		filterForm.addEventListener("submit", (event) => {
			event.preventDefault();
			loadCourses();
		});
	}

	hydrateFormFromUrl();
	loadCourses().catch(() => {
		setText(statusTarget, "Không kết nối được máy chủ.");
		renderEmpty("Không kết nối được máy chủ.");
	});
</script>

<style>
	.market-section {
		padding: clamp(42px, 6vw, 76px) 0 48px;
		background:
			radial-gradient(circle at 0% 0%, rgb(215 53 42 / 0.12), transparent 24rem),
			linear-gradient(180deg, #f2f0e8 0%, #fffdfa 52%, #f2f0e8 100%);
	}

	.market-container {
		width: min(1260px, calc(100% - 40px));
	}

	.market-hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(310px, 390px);
		gap: 24px;
		align-items: stretch;
	}

	.market-hero,
	.market-summary {
		border: 1px solid var(--line);
		border-radius: 28px;
		background: #fff;
		box-shadow: var(--shadow-sm);
	}

	.market-hero {
		padding: clamp(24px, 5vw, 44px);
		background:
			radial-gradient(circle at 92% 6%, rgb(215 53 42 / 0.14), transparent 24rem),
			#fff;
	}

	.market-hero h1 {
		max-width: 860px;
		margin: 0;
		font-size: clamp(2.25rem, 5vw, 4.45rem);
		line-height: 1.04;
		letter-spacing: 0;
		text-wrap: balance;
	}

	.market-hero p {
		max-width: 720px;
		margin: 18px 0 0;
		color: var(--muted);
		font-size: 1.06rem;
	}

	.market-summary {
		display: grid;
		align-content: start;
		gap: 14px;
		padding: 24px;
	}

	.summary-icon {
		width: 52px;
		height: 52px;
		display: grid;
		place-items: center;
		border-radius: 18px;
		background: rgb(215 53 42 / 0.1);
		color: var(--primary);
		font-size: 1.2rem;
	}

	.market-summary > strong {
		font-size: 1.2rem;
		line-height: 1.35;
	}

	.market-summary p {
		margin: 0;
		color: var(--muted);
	}

	.summary-metrics {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 10px;
	}

	.summary-metrics div {
		padding: 12px;
		border: 1px solid var(--line);
		border-radius: 16px;
		background: linear-gradient(180deg, #fff, #f8fbff);
	}

	.summary-metrics span,
	.summary-metrics small {
		display: block;
	}

	.summary-metrics span {
		color: var(--primary);
		font-size: 1.45rem;
		font-weight: 900;
		line-height: 1;
	}

	.summary-metrics small {
		margin-top: 5px;
		color: var(--muted);
		font-weight: 800;
	}

	.market-toolbar {
		position: sticky;
		top: 82px;
		z-index: 8;
		display: grid;
		grid-template-columns: minmax(260px, 1fr) 160px 160px 112px;
		gap: 12px;
		align-items: end;
		margin-top: 18px;
		padding: 14px;
		backdrop-filter: blur(18px);
	}

	.search-input {
		display: flex;
		align-items: center;
		gap: 10px;
		min-height: 48px;
		padding: 0 13px;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: #fff;
		color: var(--muted);
	}

	.search-input input {
		width: 100%;
		border: 0;
		outline: 0;
		background: transparent;
		color: var(--ink);
	}

	.result-head {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 18px;
		margin-top: 30px;
	}

	.result-head h2 {
		margin: 0;
		font-size: clamp(1.6rem, 3vw, 2.45rem);
		line-height: 1.08;
		letter-spacing: 0;
	}

	.result-head p {
		margin: 8px 0 0;
		color: var(--muted);
	}

	.text-link {
		color: var(--primary);
		font-weight: 900;
		text-decoration: none;
	}

	.market-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 18px;
		margin-top: 18px;
	}

	.market-card {
		overflow: hidden;
		display: flex;
		flex-direction: column;
		border: 1px solid var(--line);
		border-radius: 24px;
		background: #fff;
		box-shadow: var(--shadow-xs);
		transition:
			transform 220ms ease,
			box-shadow 220ms ease,
			border-color 220ms ease;
	}

	.market-card:hover {
		transform: translateY(-4px);
		border-color: rgb(215 53 42 / 0.28);
		box-shadow: var(--shadow-md);
	}

	.course-cover {
		position: relative;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		background: linear-gradient(135deg, rgb(215 53 42 / 0.12), rgb(17 17 17 / 0.08));
		text-decoration: none;
	}

	.course-cover img,
	.cover-fallback {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.course-cover img {
		transition: transform 700ms ease;
	}

	.market-card:hover .course-cover img {
		transform: scale(1.04);
	}

	.cover-fallback {
		display: grid;
		place-items: center;
		color: var(--primary);
		font-size: 2.35rem;
	}

	.course-cover span {
		position: absolute;
		top: 12px;
		left: 12px;
		padding: 6px 9px;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.94);
		color: var(--primary);
		font-size: 0.76rem;
		font-weight: 900;
	}

	.market-card-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 10px;
		padding: 16px;
	}

	.instructor-link,
	.course-purchase a {
		width: fit-content;
		color: var(--primary);
		font-size: 0.9rem;
		font-weight: 900;
		text-decoration: none;
	}

	.instructor-link {
		display: inline-flex;
		align-items: center;
		gap: 7px;
	}

	.market-card h2 {
		margin: 0;
		font-size: 1.16rem;
		line-height: 1.35;
		letter-spacing: 0;
	}

	.market-card h2 a {
		text-decoration: none;
	}

	.market-card p {
		display: -webkit-box;
		margin: 0;
		overflow: hidden;
		color: var(--muted);
		font-size: 0.95rem;
		line-height: 1.55;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.course-facts {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.course-facts small {
		padding: 6px 8px;
		border-radius: 999px;
		background: rgb(215 53 42 / 0.08);
		color: var(--primary);
		font-size: 0.78rem;
		font-weight: 800;
	}

	.course-purchase {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 12px;
		margin-top: auto;
		padding-top: 12px;
		border-top: 1px solid var(--line);
	}

	.course-purchase span,
	.course-purchase strong {
		display: block;
	}

	.course-purchase span {
		color: var(--muted);
		font-size: 0.8rem;
		font-weight: 800;
	}

	.course-purchase strong {
		color: var(--ink);
		font-size: 1.24rem;
		line-height: 1.1;
	}

	.market-actions {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 8px;
	}

	.market-actions .btn {
		min-height: 42px;
		padding: 10px 12px;
		font-size: 0.9rem;
		white-space: nowrap;
	}

	.skeleton-card {
		min-height: 390px;
		border-radius: 24px;
		background:
			linear-gradient(90deg, transparent, rgb(255 255 255 / 0.72), transparent),
			#e2e8f0;
		background-size: 240px 100%, 100% 100%;
		animation: market-shimmer 1.1s infinite linear;
	}

	@keyframes market-shimmer {
		from {
			background-position: -240px 0, 0 0;
		}
		to {
			background-position: calc(100% + 240px) 0, 0 0;
		}
	}

	.market-empty {
		grid-column: 1 / -1;
		display: grid;
		justify-items: center;
		gap: 10px;
		min-height: 260px;
		padding: 34px;
		border: 1px dashed rgb(148 163 184 / 0.5);
		border-radius: 24px;
		background: #fff;
		text-align: center;
	}

	.market-empty i {
		width: 48px;
		height: 48px;
		display: grid;
		place-items: center;
		border-radius: 16px;
		background: rgb(215 53 42 / 0.1);
		color: var(--primary);
	}

	.market-empty p {
		max-width: 520px;
		margin: 0;
		color: var(--muted);
	}

	@media (max-width: 1040px) {
		.market-hero-grid,
		.market-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.market-hero {
			grid-column: 1 / -1;
		}

		.market-toolbar {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.market-toolbar .search-field,
		.market-toolbar .btn {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 680px) {
		.market-container {
			width: min(100% - 28px, 1260px);
		}

		.market-hero-grid,
		.market-grid,
		.market-toolbar,
		.market-actions {
			grid-template-columns: 1fr;
		}

		.market-hero {
			grid-column: auto;
		}

		.result-head,
		.course-purchase {
			display: grid;
		}
	}

	.market-hero {
		position: relative;
		overflow: hidden;
		min-height: 360px;
		display: grid;
		align-content: end;
	}

	.market-hero::before {
		position: absolute;
		inset: auto 26px 26px auto;
		width: min(280px, 48%);
		aspect-ratio: 1;
		content: "";
		border: 1px solid rgb(17 17 17 / 0.12);
		background:
			repeating-linear-gradient(90deg, rgb(17 17 17 / 0.08) 0 2px, transparent 2px 11px),
			linear-gradient(135deg, rgb(215 53 42 / 0.16), transparent);
		clip-path: polygon(18% 0, 100% 0, 82% 100%, 0 100%);
		opacity: 0.72;
		pointer-events: none;
	}

	.market-hero > * {
		position: relative;
		z-index: 1;
	}

	.market-summary {
		border-left: 5px solid var(--primary);
	}

	.market-card {
		position: relative;
	}

	.market-card::after {
		position: absolute;
		right: 12px;
		bottom: 12px;
		width: 38px;
		height: 8px;
		content: "";
