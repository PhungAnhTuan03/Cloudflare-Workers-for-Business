---
import { env } from "cloudflare:workers";
import Layout from "../layouts/Layout.astro";
import { getAdminDashboardData, isAdminUser } from "../lib/admin";
import { getCurrentUser } from "../lib/auth";
import { site } from "../lib/site-data";

const currentUser = await getCurrentUser(env.DB, env.SESSION, Astro.request);

if (!currentUser) {
	return Astro.redirect("/dang-nhap");
}

const allowed = isAdminUser(currentUser, env);
if (!allowed) Astro.response.status = 403;

const data = allowed ? await getAdminDashboardData(env.DB) : null;

const statusOptions = [
	{ value: "new", label: "Moi" },
	{ value: "contacted", label: "Da lien he" },
	{ value: "consulting", label: "Dang tu van" },
	{ value: "scheduled", label: "Da hen lich" },
	{ value: "won", label: "Chot hoc" },
	{ value: "lost", label: "That bai" },
];

const roleOptions = [
	{ value: "student", label: "Hoc vien" },
	{ value: "instructor", label: "Giang vien" },
	{ value: "admin", label: "Admin" },
];

const userStatusOptions = [
	{ value: "active", label: "Hoat dong" },
	{ value: "suspended", label: "Tam khoa" },
];

const courseStatusOptions = [
	{ value: "draft", label: "Ban nhap" },
	{ value: "published", label: "Dang ban" },
];

const formatNumber = (value: number) => Number(value || 0).toLocaleString("vi-VN");
const formatMoney = (value: number) => `${formatNumber(value)}d`;
const formatDate = (value?: string | null) =>
	value ? new Intl.DateTimeFormat("vi-VN", { dateStyle: "short", timeStyle: "short" }).format(new Date(value)) : "-";

const reportActions = [
	{
		title: "Minh bach phap ly",
		text: "Bo sung ma so thue, giay phep dao tao, chinh sach thanh toan va hoan tien.",
		owner: "Admin",
	},
	{
		title: "Quan ly khoa hoc",
		text: "Kiem soat trang thai khoa hoc, hoc phi, lich khai giang va tai lieu ban kem.",
		owner: "Dao tao",
	},
	{
		title: "Lead tu van",
		text: "Theo doi lead theo trang thai moi, dang tu van, da hen lich va chot hoc.",
		owner: "Tuyen sinh",
	},
	{
		title: "Local SEO",
		text: "Quan ly chi nhanh, landing page dia phuong, tu khoa khoa hoc theo tinh thanh.",
		owner: "Marketing",
	},
	{
		title: "Noi dung SEO",
		text: "Duyet bai tin tuc, bai hoc phi, FAQ, trang chinh sach va bai viet theo nganh.",
		owner: "Editor",
	},
];
---

<Layout
	title={`Admin - ${site.name}`}
	description="Trang admin quan ly lead, khoa hoc, nguoi dung, chung chi, chi nhanh va noi dung website."
>
	{
		!allowed || !data ? (
			<section class="admin-denied">
				<div class="container denied-card card">
					<span class="admin-kicker"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Admin</span>
					<h1>Ban khong co quyen vao trang quan tri.</h1>
					<p>Hay dang nhap bang tai khoan admin hoac email duoc cau hinh trong bien ADMIN_EMAIL.</p>
					<a class="btn btn-primary" href="/dashboard">Ve dashboard</a>
				</div>
			</section>
		) : (
			<section class="admin-page" data-admin-root>
				<div class="container admin-shell">
					<aside class="admin-sidebar card">
						<a href="/admin" class="admin-brand">
							<span><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></span>
							<strong>Admin Center</strong>
						</a>
						<nav aria-label="Admin navigation">
							<a href="#overview" class="active"><i class="fa-solid fa-chart-line" aria-hidden="true"></i> Tong quan</a>
							<a href="#leads"><i class="fa-solid fa-headset" aria-hidden="true"></i> Lead tu van</a>
							<a href="#courses"><i class="fa-solid fa-book-open" aria-hidden="true"></i> Khoa hoc</a>
							<a href="#users"><i class="fa-solid fa-users" aria-hidden="true"></i> Nguoi dung</a>
							<a href="#content"><i class="fa-solid fa-newspaper" aria-hidden="true"></i> Noi dung</a>
							<a href="/_emdash/admin"><i class="fa-solid fa-pen-nib" aria-hidden="true"></i> EmDash CMS</a>
						</nav>
					</aside>

					<main class="admin-main">
						<section id="overview" class="admin-hero">
							<div>
								<span class="admin-kicker"><i class="fa-solid fa-layer-group" aria-hidden="true"></i> Website Operations</span>
								<h1>Quan ly website dao tao, lead, khoa hoc va noi dung trong mot man hinh.</h1>
								<p>
									Dua tren report phan tich: website can quan tri ro cac nhom khoa hoc, hoc vien, giang vien,
									chi nhanh, chung chi, noi dung SEO va minh bach phap ly.
								</p>
							</div>
							<div class="admin-identity">
								<span>{currentUser.full_name.slice(0, 2).toUpperCase()}</span>
								<strong>{currentUser.full_name}</strong>
								<small>{currentUser.email}</small>
							</div>
						</section>

						<section class="admin-stats" aria-label="Thong ke admin">
							<article class="stat-card">
								<span><i class="fa-solid fa-headset" aria-hidden="true"></i></span>
								<small>Lead moi</small>
								<strong>{formatNumber(data.stats.newLeads)}</strong>
							</article>
							<article class="stat-card">
								<span><i class="fa-solid fa-book-open" aria-hidden="true"></i></span>
								<small>Khoa hoc dang ban</small>
								<strong>{formatNumber(data.stats.publishedCourses)}</strong>
							</article>
							<article class="stat-card">
								<span><i class="fa-solid fa-users" aria-hidden="true"></i></span>
								<small>Nguoi dung</small>
								<strong>{formatNumber(data.stats.totalUsers)}</strong>
							</article>
							<article class="stat-card">
								<span><i class="fa-solid fa-wallet" aria-hidden="true"></i></span>
								<small>Doanh thu</small>
								<strong>{formatMoney(data.stats.totalRevenue)}</strong>
							</article>
							<article class="stat-card">
								<span><i class="fa-solid fa-certificate" aria-hidden="true"></i></span>
								<small>Chung chi</small>
								<strong>{formatNumber(data.stats.totalCertificates)}</strong>
							</article>
							<article class="stat-card">
								<span><i class="fa-solid fa-location-dot" aria-hidden="true"></i></span>
								<small>Chi nhanh active</small>
								<strong>{formatNumber(data.stats.activeLocations)}</strong>
							</article>
						</section>

						<section class="admin-grid">
							<article class="admin-panel lead-chart">
								<div class="panel-head">
									<div>
										<h2>Pipeline tuyen sinh</h2>
										<p>Trang thai lead tu form dang ky tu van.</p>
									</div>
								</div>
								<div class="pipeline-bars">
									{
										statusOptions.map((status) => {
											const count = data.leadStatuses.find((item) => item.status === status.value)?.value ?? 0;
											const percent = data.stats.totalLeads ? Math.max(8, Math.round((count / data.stats.totalLeads) * 100)) : 8;
											return (
												<div>
													<span>{status.label}</span>
													<div><i style={`width: ${percent}%`}></i></div>
													<strong>{formatNumber(count)}</strong>
												</div>
											);
										})
									}
								</div>
							</article>

							<article class="admin-panel report-panel">
								<div class="panel-head">
									<div>
										<h2>Checklist tu report</h2>
										<p>Cac vung can quan ly de website ro, nhanh va minh bach hon.</p>
									</div>
								</div>
								<div class="report-list">
									{
										reportActions.map((item) => (
											<div>
												<span>{item.owner}</span>
												<strong>{item.title}</strong>
												<p>{item.text}</p>
											</div>
										))
									}
								</div>
							</article>
						</section>

						<section id="leads" class="admin-panel">
							<div class="panel-head">
								<div>
									<h2>Lead dang ky tu van</h2>
									<p>Quan ly luong tu van theo khoa hoc, co so va trang thai cham soc.</p>
								</div>
								<a class="btn btn-secondary" href="/dang-ky-tu-van">Xem form public</a>
							</div>
							<div class="admin-table lead-table">
								<div class="table-head">
									<span>Khach hang</span>
									<span>Khoa hoc / co so</span>
									<span>Trang thai</span>
									<span>Phu trach</span>
									<span>Thoi gian</span>
								</div>
								{
									data.recentLeads.length ? (
										data.recentLeads.map((lead) => (
											<article class="table-row">
												<div>
													<strong>{lead.full_name}</strong>
													<small>{lead.phone} {lead.email ? `- ${lead.email}` : ""}</small>
												</div>
												<div>
													<strong>{lead.course_slug || "Chua chon khoa"}</strong>
													<small>{lead.location_slug || "Chua chon co so"}</small>
												</div>
												<select data-admin-lead-status data-public-id={lead.public_id} aria-label="Cap nhat trang thai lead">
													{statusOptions.map((status) => (
														<option value={status.value} selected={lead.status === status.value}>{status.label}</option>
													))}
												</select>
												<input data-admin-lead-owner data-public-id={lead.public_id} value={lead.assigned_to || ""} placeholder="Nhan vien" />
												<small>{formatDate(lead.created_at)}</small>
											</article>
										))
									) : (
										<div class="empty-state">Chua co lead tu van nao.</div>
									)
								}
							</div>
						</section>

						<section id="courses" class="admin-panel">
							<div class="panel-head">
								<div>
									<h2>Khoa hoc giang vien dang ban</h2>
									<p>Duyet nhanh khoa hoc marketplace, doanh thu va trang thai hien thi.</p>
								</div>
								<a class="btn btn-primary" href="/marketplace">Xem marketplace</a>
							</div>
							<div class="admin-table course-table">
								<div class="table-head">
									<span>Khoa hoc</span>
									<span>Giang vien</span>
									<span>Hoc vien</span>
									<span>Doanh thu</span>
									<span>Trang thai</span>
								</div>
								{
									data.recentCourses.length ? (
										data.recentCourses.map((course) => (
											<article class="table-row">
												<div>
													<strong>{course.title}</strong>
													<small>{formatMoney(course.price)} - Tao luc {formatDate(course.created_at)}</small>
												</div>
												<span>{course.instructor_name}</span>
												<span>{formatNumber(course.purchase_count)}</span>
												<span>{formatMoney(course.revenue)}</span>
												<select data-admin-course-status data-public-id={course.public_id} aria-label="Cap nhat trang thai khoa hoc">
													{courseStatusOptions.map((status) => (
														<option value={status.value} selected={course.status === status.value}>{status.label}</option>
													))}
												</select>
											</article>
										))
									) : (
										<div class="empty-state">Chua co khoa hoc giang vien nao.</div>
									)
								}
							</div>
						</section>

						<section id="users" class="admin-panel">
							<div class="panel-head">
								<div>
									<h2>Nguoi dung va phan quyen</h2>
									<p>Quan ly hoc vien, giang vien va admin cua he thong.</p>
								</div>
								<span class="panel-badge">{formatNumber(data.stats.totalStudents)} hoc vien - {formatNumber(data.stats.totalInstructors)} giang vien</span>
							</div>
							<div class="admin-table user-table">
								<div class="table-head">
									<span>Nguoi dung</span>
									<span>Lien he</span>
									<span>Vai tro</span>
									<span>Trang thai</span>
									<span>Ngay tao</span>
								</div>
								{
									data.recentUsers.length ? (
										data.recentUsers.map((user) => (
											<article class="table-row">
												<div>
													<strong>{user.full_name}</strong>
													<small>{user.public_id}</small>
												</div>
												<div>
													<strong>{user.email}</strong>
													<small>{user.phone || "Chua co so dien thoai"}</small>
												</div>
												<select data-admin-user-role data-public-id={user.public_id} aria-label="Cap nhat vai tro">
													{roleOptions.map((role) => (
														<option value={role.value} selected={user.role === role.value}>{role.label}</option>
													))}
												</select>
												<select data-admin-user-status data-public-id={user.public_id} aria-label="Cap nhat trang thai tai khoan">
													{userStatusOptions.map((status) => (
														<option value={status.value} selected={user.status === status.value}>{status.label}</option>
													))}
												</select>
												<small>{formatDate(user.created_at)}</small>
											</article>
										))
									) : (
										<div class="empty-state">Chua co nguoi dung nao.</div>
									)
								}
							</div>
						</section>

						<section id="content" class="admin-grid">
							<article class="admin-panel">
								<div class="panel-head">
									<div>
										<h2>CMS va SEO</h2>
										<p>Quan ly bai viet, trang gioi thieu, chinh sach va landing page dia phuong trong EmDash.</p>
									</div>
								</div>
								<div class="quick-links">
									<a href="/_emdash/admin"><i class="fa-solid fa-pen-nib" aria-hidden="true"></i> Mo EmDash Admin</a>
									<a href="/tin-tuc"><i class="fa-solid fa-newspaper" aria-hidden="true"></i> Xem tin tuc</a>
									<a href="/khoa-hoc"><i class="fa-solid fa-book" aria-hidden="true"></i> Xem trang khoa hoc</a>
									<a href="/lien-he"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> Xem trang chi nhanh</a>
								</div>
							</article>

							<article class="admin-panel">
								<div class="panel-head">
									<div>
										<h2>Chung chi va chi nhanh</h2>
										<p>Ho tro minh bach: tra cuu chung nhan, dia diem, lich khai giang.</p>
									</div>
								</div>
								<div class="ops-list">
									<div><strong>{formatNumber(data.stats.totalCertificates)}</strong><span>chung chi trong he thong</span></div>
									<div><strong>{formatNumber(data.stats.activeLocations)}</strong><span>chi nhanh dang hoat dong</span></div>
									<div><strong>{formatNumber(data.stats.openCohorts)}</strong><span>lop sap khai giang</span></div>
									<div><strong>{formatNumber(data.stats.totalMessages)}</strong><span>tin nhan hoc vien va giang vien</span></div>
								</div>
							</article>
						</section>

						<section class="admin-grid">
							<article class="admin-panel">
								<div class="panel-head">
									<div>
										<h2>Chung chi gan day</h2>
										<p>Du lieu phuc vu trang tra cuu chung nhan.</p>
									</div>
								</div>
								<div class="compact-list">
									{
										data.recentCertificates.length ? (
											data.recentCertificates.map((cert) => (
												<div>
													<strong>{cert.code}</strong>
													<span>{cert.student_name} - {cert.course_name}</span>
													<small>{cert.status} - {formatDate(cert.issued_at)}</small>
												</div>
											))
										) : (
											<p class="empty-small">Chua co chung chi.</p>
										)
									}
								</div>
							</article>

							<article class="admin-panel">
								<div class="panel-head">
									<div>
										<h2>Chi nhanh</h2>
										<p>Quan ly local SEO va thong tin lien he theo dia phuong.</p>
									</div>
								</div>
								<div class="compact-list">
									{
										data.locations.length ? (
											data.locations.map((location) => (
												<div>
													<strong>{location.name}</strong>
													<span>{location.province} - {location.address}</span>
													<small>{location.phone || "Chua co hotline"} - {location.is_active ? "Dang hoat dong" : "Tam an"}</small>
												</div>
											))
										) : (
											<p class="empty-small">Chua co du lieu chi nhanh.</p>
										)
									}
								</div>
							</article>
						</section>

						<section class="admin-panel audit-panel">
							<div class="panel-head">
								<div>
									<h2>Nhat ky he thong</h2>
									<p>Theo doi cac thao tac quan tri quan trong.</p>
								</div>
								<p class="admin-status" data-admin-status></p>
							</div>
							<div class="audit-list">
								{
									data.auditLogs.length ? (
										data.auditLogs.map((log) => (
											<div>
												<strong>{log.action}</strong>
												<span>{log.entity_type} #{log.entity_id}</span>
												<small>{log.actor_id || "system"} - {formatDate(log.created_at)}</small>
											</div>
										))
									) : (
										<p class="empty-small">Chua co audit log.</p>
									)
								}
							</div>
						</section>
					</main>
				</div>
			</section>
		)
	}
</Layout>

<script>
	const statusTarget = document.querySelector("[data-admin-status]");

	function setStatus(message: string, state = "idle") {
		if (!(statusTarget instanceof HTMLElement)) return;
		statusTarget.textContent = message;
		statusTarget.dataset.state = state;
	}

	async function patchAdmin(endpoint: string, payload: Record<string, unknown>) {
		setStatus("Dang cap nhat...");
		const response = await fetch(endpoint, {
			method: "PATCH",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify(payload),
		});
		const result = (await response.json().catch(() => ({}))) as { message?: string };
		setStatus(result.message || (response.ok ? "Da cap nhat." : "Khong cap nhat duoc."), response.ok ? "success" : "error");
	}

	for (const select of document.querySelectorAll("[data-admin-user-role]")) {
		select.addEventListener("change", () => {
			if (!(select instanceof HTMLSelectElement)) return;
			patchAdmin("/api/admin/users", { publicId: select.dataset.publicId, role: select.value });
		});
	}

	for (const select of document.querySelectorAll("[data-admin-user-status]")) {
		select.addEventListener("change", () => {
			if (!(select instanceof HTMLSelectElement)) return;
			patchAdmin("/api/admin/users", { publicId: select.dataset.publicId, status: select.value });
		});
	}

	for (const select of document.querySelectorAll("[data-admin-course-status]")) {
		select.addEventListener("change", () => {
			if (!(select instanceof HTMLSelectElement)) return;
			patchAdmin("/api/admin/courses", { publicId: select.dataset.publicId, status: select.value });
		});
	}

	for (const select of document.querySelectorAll("[data-admin-lead-status]")) {
		select.addEventListener("change", () => {
			if (!(select instanceof HTMLSelectElement)) return;
			const owner = document.querySelector(`[data-admin-lead-owner][data-public-id="${select.dataset.publicId}"]`);
			patchAdmin("/api/admin/leads", {
				publicId: select.dataset.publicId,
				status: select.value,
				assignedTo: owner instanceof HTMLInputElement ? owner.value : "",
				note: "Cap nhat tu admin dashboard",
			});
		});
	}

	for (const input of document.querySelectorAll("[data-admin-lead-owner]")) {
		input.addEventListener("change", () => {
			if (!(input instanceof HTMLInputElement)) return;
			const status = document.querySelector(`[data-admin-lead-status][data-public-id="${input.dataset.publicId}"]`);
			patchAdmin("/api/admin/leads", {
				publicId: input.dataset.publicId,
				status: status instanceof HTMLSelectElement ? status.value : undefined,
				assignedTo: input.value,
				note: "Gan nguoi phu trach tu admin dashboard",
			});
		});
	}
</script>

<style>
	.admin-denied,
	.admin-page {
		padding: 26px 0 36px;
		background:
			radial-gradient(circle at 0% 0%, rgb(96 165 250 / 0.14), transparent 26rem),
			linear-gradient(180deg, #f8fafc 0%, #ffffff 58%, #f8fafc 100%);
	}

	.denied-card {
		max-width: 720px;
		padding: 28px;
		border-radius: 24px;
	}

	.denied-card h1 {
		margin: 10px 0;
		font-size: clamp(2rem, 4vw, 3.4rem);
		line-height: 1.08;
	}

	.denied-card p {
		color: var(--muted);
	}

	.admin-page .container {
		width: min(1380px, calc(100% - 32px));
	}

	.admin-shell {
		display: grid;
		grid-template-columns: 228px minmax(0, 1fr);
		gap: 16px;
		align-items: start;
	}

	.admin-sidebar {
		position: sticky;
		top: 88px;
		display: grid;
		gap: 16px;
		padding: 14px;
		border-radius: 24px;
		background: rgb(255 255 255 / 0.94);
		box-shadow: var(--shadow-sm);
	}

	.admin-brand {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 8px;
		color: var(--ink);
		text-decoration: none;
	}

	.admin-brand span {
		width: 40px;
		height: 40px;
		display: grid;
		place-items: center;
		border-radius: 14px;
		background: linear-gradient(135deg, var(--primary), var(--secondary));
		color: #fff;
	}

	.admin-sidebar nav {
		display: grid;
		gap: 6px;
	}

	.admin-sidebar nav a {
		display: flex;
		align-items: center;
		gap: 10px;
		min-height: 42px;
		padding: 0 11px;
		border-radius: 999px;
		color: #475569;
		font-weight: 900;
		text-decoration: none;
	}

	.admin-sidebar nav a:hover,
	.admin-sidebar nav a.active {
		background: rgb(37 99 235 / 0.1);
		color: var(--primary);
	}

	.admin-main {
		display: grid;
		gap: 14px;
		min-width: 0;
	}

	.admin-hero,
	.admin-panel,
	.stat-card {
		border: 1px solid var(--line);
		background: #fff;
		box-shadow: var(--shadow-sm);
	}

	.admin-hero {
