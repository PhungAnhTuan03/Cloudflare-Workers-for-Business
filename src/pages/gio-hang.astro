---
import Layout from "../layouts/Layout.astro";
import { site } from "../lib/site-data";

const schema = {
	"@context": "https://schema.org",
	"@type": "CheckoutPage",
	name: "Giỏ hàng khóa học",
	url: `${site.url}/gio-hang`,
};
---

<Layout
	title={`Giỏ hàng - ${site.name}`}
	description="Giỏ hàng và checkout khóa học trực tuyến tại Sao Việt Tech Academy."
	canonical={`${site.url}/gio-hang`}
	schema={schema}
>
	<section class="cart-section">
		<div class="container cart-grid">
			<div class="cart-main">
				<div class="cart-hero card">
					<span class="page-kicker">
						<i class="fa-solid fa-cart-shopping" aria-hidden="true"></i>
						Giỏ hàng khóa học
					</span>
					<h1>Kiểm tra khóa học trước khi mở quyền học.</h1>
					<p>
						Sau khi checkout thành công, khóa học sẽ xuất hiện trong dashboard học viên và bạn có thể nhắn tin
						riêng với giảng viên của khóa học đó.
					</p>
				</div>

				<div class="cart-panel card">
					<div class="panel-head">
						<div>
							<h2>Khóa học sắp mua</h2>
							<p><span data-cart-count>0</span> khóa học trong giỏ hàng</p>
						</div>
						<a href="/marketplace" class="btn btn-secondary">
							<i class="fa-solid fa-store" aria-hidden="true"></i>
							Xem thêm khóa học
						</a>
					</div>
					<div data-cart-items class="cart-items">
						<div class="loading-state">Đang tải giỏ hàng...</div>
					</div>
				</div>
			</div>

			<aside class="checkout-panel card">
				<div class="checkout-icon">
					<i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
				</div>
				<h2>Tóm tắt thanh toán</h2>
				<p class="checkout-note">Áp dụng coupon nếu giảng viên hoặc trung tâm đã cấp mã ưu đãi cho bạn.</p>

				<form data-coupon-form class="coupon-form">
					<div class="field">
						<label for="coupon-code">Mã coupon</label>
						<input id="coupon-code" name="couponCode" placeholder="Ví dụ: SVTECH20" />
					</div>
					<button class="btn btn-secondary" type="submit">
						<i class="fa-solid fa-ticket" aria-hidden="true"></i>
						Áp dụng
					</button>
				</form>

				<div class="summary">
					<span>Tạm tính</span>
					<strong data-cart-total>0đ</strong>
				</div>
				<button class="btn btn-primary checkout-btn" type="button" data-checkout>
					<i class="fa-solid fa-credit-card" aria-hidden="true"></i>
					Checkout khóa học
				</button>
				<p class="form-status" data-cart-status aria-live="polite"></p>
			</aside>
		</div>
	</section>
</Layout>

<script>
	type CartItem = {
		cart_item_id: number;
		course_public_id: string;
		title: string;
		description: string;
		price: number;
		instructor_name: string;
		coupon_code?: string | null;
		discount_type?: string | null;
		discount_value?: number | null;
	};
	type ApiResult = {
		ok?: boolean;
		message?: string;
		items?: CartItem[];
	};

	const list = document.querySelector("[data-cart-items]");
	const total = document.querySelector("[data-cart-total]");
	const count = document.querySelector("[data-cart-count]");
	const status = document.querySelector("[data-cart-status]");
	const couponForm = document.querySelector("[data-coupon-form]");
	const checkoutButton = document.querySelector("[data-checkout]");

	function setText(target: Element | null, value: string) {
		if (target instanceof HTMLElement) target.textContent = value;
	}

	function escapeHtml(value: string) {
		return value.replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char] || char);
	}

	function formatCurrency(value: number) {
		return `${Number(value || 0).toLocaleString("vi-VN")}đ`;
	}

	function finalPrice(item: CartItem) {
		if (!item.discount_type || !item.discount_value) return Number(item.price);
		if (item.discount_type === "fixed") return Math.max(0, Number(item.price) - Number(item.discount_value));
		return Math.max(0, Math.round(Number(item.price) * (1 - Number(item.discount_value) / 100)));
	}

	function renderEmpty(message = "Giỏ hàng đang trống.") {
		if (!(list instanceof HTMLElement)) return;
		list.innerHTML = `
			<div class="empty-state">
				<div>
					<strong>${escapeHtml(message)}</strong>
					<p>Hãy chọn một khóa học phù hợp để bắt đầu học và mở kênh trao đổi với giảng viên.</p>
					<a class="btn btn-primary" href="/marketplace">Khám phá marketplace</a>
				</div>
			</div>
		`;
	}

	async function loadCart() {
		const response = await fetch("/api/cart");
		const result = (await response.json()) as ApiResult;
		if (!(list instanceof HTMLElement)) return;

		if (!response.ok || !result.ok) {
			setText(count, "0");
			setText(total, "0đ");
			renderEmpty(result.message || "Bạn cần đăng nhập để xem giỏ hàng.");
			return;
		}

		const items = result.items || [];
		const sum = items.reduce((value, item) => value + finalPrice(item), 0);
		setText(count, String(items.length));
		setText(total, formatCurrency(sum));

		if (!items.length) {
			renderEmpty();
			return;
		}

		list.innerHTML = items
			.map((item) => {
				const originalPrice = Number(item.price || 0);
				const discountedPrice = finalPrice(item);
				return `
					<article class="cart-item">
						<div class="course-thumb">
							<i class="fa-solid fa-laptop-code" aria-hidden="true"></i>
						</div>
						<div class="cart-item-body">
							<div>
								<strong>${escapeHtml(item.title)}</strong>
								<span>Giảng viên: ${escapeHtml(item.instructor_name)}</span>
								<p>${escapeHtml(item.description || "Khóa học trực tuyến có bài giảng và tài liệu riêng.")}</p>
							</div>
							<div class="cart-item-actions">
								<a href="/khoa-hoc-giang-vien/${encodeURIComponent(item.course_public_id)}">Xem chi tiết</a>
								<button type="button" data-remove="${item.cart_item_id}">
									<i class="fa-solid fa-trash-can" aria-hidden="true"></i>
									Xóa
								</button>
							</div>
						</div>
						<div class="price-box">
							${item.coupon_code ? `<small>Coupon ${escapeHtml(item.coupon_code)}</small>` : "<small>Học phí</small>"}
							<strong>${formatCurrency(discountedPrice)}</strong>
							${discountedPrice < originalPrice ? `<span>${formatCurrency(originalPrice)}</span>` : ""}
						</div>
					</article>
				`;
			})
			.join("");

		for (const button of document.querySelectorAll("[data-remove]")) {
			if (!(button instanceof HTMLButtonElement)) continue;
			button.addEventListener("click", async () => {
				button.disabled = true;
				await fetch(`/api/cart/${button.getAttribute("data-remove")}`, { method: "DELETE" });
				await loadCart();
			});
		}
	}

	if (couponForm instanceof HTMLFormElement) {
		couponForm.addEventListener("submit", async (event) => {
			event.preventDefault();
			const payload = Object.fromEntries(new FormData(couponForm));
			setText(status, "Đang áp dụng coupon...");
			const response = await fetch("/api/cart", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify(payload),
			});
			const result = (await response.json()) as ApiResult;
			setText(status, result.message || (response.ok ? "Đã áp dụng coupon." : "Coupon không hợp lệ."));
			if (response.ok) couponForm.reset();
			await loadCart();
		});
	}

	if (checkoutButton instanceof HTMLButtonElement) {
		checkoutButton.addEventListener("click", async () => {
			checkoutButton.disabled = true;
			setText(status, "Đang checkout khóa học...");
			const response = await fetch("/api/cart", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ checkout: true }),
			});
			const result = (await response.json()) as ApiResult;
			setText(status, result.message || (response.ok ? "Thanh toán thành công." : "Không checkout được."));
			if (response.ok) window.location.href = "/hoc-vien/dashboard";
			checkoutButton.disabled = false;
		});
	}

	loadCart().catch(() => renderEmpty("Không tải được giỏ hàng."));
</script>

<style>
	.cart-section {
		padding: clamp(38px, 6vw, 72px) 0 34px;
		background:
			radial-gradient(circle at 0% 0%, rgb(96 165 250 / 0.14), transparent 24rem),
			linear-gradient(180deg, #f8fafc 0%, #ffffff 58%, #f8fafc 100%);
	}

	.cart-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(320px, 390px);
		gap: 20px;
		align-items: start;
	}

	.cart-main {
		display: grid;
		gap: 18px;
	}

	.cart-hero,
	.cart-panel,
	.checkout-panel {
		padding: clamp(20px, 3vw, 28px);
	}

	.cart-hero {
		background:
			radial-gradient(circle at 94% 12%, rgb(96 165 250 / 0.18), transparent 20rem),
			#fff;
	}

	.cart-hero h1 {
		max-width: 820px;
		margin: 0;
		font-size: clamp(2rem, 4.4vw, 4rem);
		line-height: 1.06;
		letter-spacing: 0;
	}

	.cart-hero p,
	.checkout-note,
	.panel-head p {
		color: var(--muted);
	}

	.cart-hero p {
		max-width: 740px;
		margin: 14px 0 0;
	}

	.panel-head {
		display: flex;
		align-items: start;
		justify-content: space-between;
		gap: 14px;
		margin-bottom: 18px;
	}

	.panel-head h2,
	.checkout-panel h2 {
		margin: 0;
		font-size: 1.2rem;
	}

	.panel-head p {
		margin: 5px 0 0;
	}

	.cart-items {
		display: grid;
		gap: 12px;
	}

	.cart-item {
		display: grid;
		grid-template-columns: 92px minmax(0, 1fr) 140px;
		gap: 14px;
		align-items: stretch;
		padding: 12px;
		border: 1px solid var(--line);
		border-radius: 22px;
		background: linear-gradient(180deg, #fff, #f8fbff);
		box-shadow: var(--shadow-xs);
	}

	.course-thumb {
		display: grid;
		place-items: center;
		min-height: 108px;
		border-radius: 18px;
		background: linear-gradient(135deg, var(--primary), var(--secondary));
		color: #fff;
		font-size: 1.65rem;
	}

	.cart-item-body {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 12px;
		min-width: 0;
	}

	.cart-item-body strong,
	.cart-item-body span,
	.cart-item-body p {
		display: block;
	}

	.cart-item-body strong {
		font-size: 1.05rem;
		line-height: 1.35;
	}

	.cart-item-body span,
	.cart-item-body p {
		color: var(--muted);
	}

	.cart-item-body p {
		margin: 5px 0 0;
		font-size: 0.92rem;
	}

	.cart-item-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.cart-item-actions a,
	.cart-item-actions button {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		border: 0;
		background: transparent;
		color: var(--primary);
		font-weight: 900;
		text-decoration: none;
		cursor: pointer;
	}

	.cart-item-actions button {
		color: var(--danger);
	}

	.price-box {
		display: grid;
		align-content: center;
		justify-items: end;
		gap: 4px;
		padding: 12px;
		border-radius: 18px;
		background: #fff;
	}

	.price-box small,
	.price-box span {
		color: var(--muted);
	}

	.price-box strong {
		font-size: 1.15rem;
	}

	.price-box span {
		text-decoration: line-through;
	}

	.checkout-panel {
		position: sticky;
		top: 92px;
	}

	.checkout-icon {
		width: 48px;
		height: 48px;
		display: grid;
		place-items: center;
		margin-bottom: 14px;
		border-radius: 16px;
		background: rgb(37 99 235 / 0.1);
		color: var(--primary);
	}

	.coupon-form {
		display: grid;
		gap: 12px;
		margin-top: 18px;
	}

	.summary {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		margin: 22px 0;
		padding-top: 18px;
		border-top: 1px solid var(--line);
	}

	.summary strong {
		font-size: 1.5rem;
	}

	.checkout-btn {
		width: 100%;
	}

	@media (max-width: 920px) {
		.cart-grid {
			grid-template-columns: 1fr;
		}

		.checkout-panel {
			position: static;
		}
	}

	@media (max-width: 680px) {
		.panel-head,
		.cart-item {
			grid-template-columns: 1fr;
		}

		.course-thumb {
			min-height: 90px;
		}

		.price-box {
			justify-items: start;
		}
	}
</style>
