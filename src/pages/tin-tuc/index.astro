---
import Layout from "../../layouts/Layout.astro";
import { articles, courseCategories, site } from "../../lib/site-data";

const schema = {
	"@context": "https://schema.org",
	"@type": "Blog",
	name: "Tin tức đào tạo công nghệ",
	url: `${site.url}/tin-tuc`,
	description: "Bài viết về AI, lập trình, thiết kế, tin học văn phòng và định hướng nghề nghiệp.",
};
---

<Layout
	title="Tin tức đào tạo công nghệ"
	description="Cập nhật kinh nghiệm học AI, lập trình, thiết kế, tin học văn phòng và Digital Marketing."
	canonical={`${site.url}/tin-tuc`}
	schema={schema}
>
	<section class="page-hero">
		<div class="container">
			<span class="page-kicker">
				<i class="fa-solid fa-newspaper" aria-hidden="true"></i>
				Tin tức và cẩm nang
			</span>
			<h1 class="page-title">Góc học tập cho người muốn nâng cấp kỹ năng số.</h1>
			<p class="page-lead">
				Nội dung ngắn gọn, thực tế, tập trung vào cách học hiệu quả và cách áp dụng kỹ năng vào công việc.
			</p>
		</div>
	</section>

	<section class="section news-section">
		<div class="container news-layout">
			<div class="news-grid">
				{articles.map((article, index) => (
					<article class:list={["news-card", "card", index === 0 && "is-image-only"]} id={article.slug}>
						<a href={`/tin-tuc/${article.slug}`} class="news-image" aria-label={`Đọc ${article.title}`}>
							<img src={article.image} alt={article.title} loading="lazy" />
						</a>
						{index !== 0 && (
							<div class="news-card-body">
								<div class="news-meta">
									<span>{article.category}</span>
									<span>{article.date}</span>
								</div>
								<h2><a href={`/tin-tuc/${article.slug}`}>{article.title}</a></h2>
								<p>{article.description}</p>
								<a class="read-link" href={`/tin-tuc/${article.slug}`}>
									Đọc bài viết
									<i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
								</a>
							</div>
						)}
					</article>
				))}
			</div>

			<aside class="news-sidebar card">
				<h2>Chủ đề nổi bật</h2>
				{courseCategories.map((category) => (
					<a href={category.href}>
						<i class={category.icon} aria-hidden="true" style={`color: ${category.accent}`}></i>
						<span>{category.title}</span>
					</a>
				))}
			</aside>
		</div>
	</section>
</Layout>

<style>
	.news-section {
		padding-top: clamp(36px, 5vw, 64px);
	}

	.news-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(250px, 286px);
		gap: 24px;
		align-items: start;
	}

	.news-grid {
		display: grid;
		gap: 16px;
	}

	.news-card {
		overflow: hidden;
		min-height: 252px;
		display: grid;
		grid-template-columns: minmax(260px, 0.42fr) minmax(0, 1fr);
		border: 1px solid rgb(17 17 17 / 0.16) !important;
		border-radius: 8px !important;
		background:
			linear-gradient(90deg, rgb(215 53 42 / 0.09) 0 5px, transparent 5px),
			rgb(255 255 255 / 0.9) !important;
		box-shadow: 0 16px 38px rgb(17 17 17 / 0.08) !important;
		transition:
			transform 280ms var(--motion-ease),
			border-color 280ms var(--motion-ease),
			box-shadow 280ms var(--motion-ease);
	}

	.news-card:hover {
		transform: translateY(-3px);
		border-color: rgb(215 53 42 / 0.32) !important;
		box-shadow: 0 24px 56px rgb(17 17 17 / 0.12) !important;
	}

	.news-card.is-image-only {
		min-height: 360px;
		grid-template-columns: 1fr;
		padding: 8px;
		background:
			linear-gradient(rgb(17 17 17 / 0.04) 1px, transparent 1px),
			linear-gradient(90deg, rgb(17 17 17 / 0.04) 1px, transparent 1px),
			rgb(255 255 255 / 0.92) !important;
		background-size: 18px 18px, 18px 18px, auto !important;
	}

	.news-card.is-image-only .news-image {
		min-height: 344px;
		border: 0;
		border-radius: 6px;
	}

	.news-card.is-image-only .news-image::before {
		position: absolute;
		inset: 14px;
		z-index: 1;
		content: "";
		border: 1px solid rgb(255 255 255 / 0.48);
		pointer-events: none;
	}

	.news-card.is-image-only .news-image::after {
		background:
			linear-gradient(180deg, transparent 42%, rgb(17 17 17 / 0.24)),
			repeating-linear-gradient(0deg, rgb(255 255 255 / 0.08) 0 1px, transparent 1px 5px);
	}

	.news-card.is-image-only img {
		min-height: 344px;
		filter: saturate(1.04) contrast(1.04);
	}

	.news-image {
		position: relative;
		overflow: hidden;
		min-height: 252px;
		border-right: 1px solid rgb(17 17 17 / 0.14);
		background: #d9d4c9;
		text-decoration: none;
	}

	.news-image::after {
		position: absolute;
		inset: 0;
		content: "";
		background:
			linear-gradient(180deg, transparent 46%, rgb(17 17 17 / 0.2)),
			repeating-linear-gradient(0deg, rgb(255 255 255 / 0.08) 0 1px, transparent 1px 5px);
		pointer-events: none;
	}

	.news-card img {
		width: 100%;
		height: 100%;
		min-height: 252px;
		object-fit: cover;
		transition: transform 700ms var(--motion-ease);
	}

	.news-card:hover img {
		transform: scale(1.045);
	}

	.news-card-body {
		display: grid;
		align-content: center;
		gap: 12px;
		padding: clamp(22px, 3vw, 32px);
	}

	.news-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		color: var(--primary);
		font-family: var(--font-mono);
		font-size: 0.76rem;
		font-weight: 900;
		line-height: 1.25;
	}

	.news-card h2 {
		display: -webkit-box;
		margin: 0;
		overflow: hidden;
		color: var(--ink);
		font-size: clamp(1.55rem, 2.2vw, 2.15rem);
		font-weight: 900;
		line-height: 1.12;
		letter-spacing: 0;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.news-card h2 a,
	.read-link,
	.news-sidebar a {
		color: inherit;
		text-decoration: none;
	}

	.news-card p {
		display: -webkit-box;
		max-width: 62ch;
		margin: 0;
		overflow: hidden;
		color: var(--muted);
		font-size: 1rem;
		line-height: 1.68;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.read-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		width: fit-content;
		color: var(--primary);
		font-weight: 900;
	}

	.read-link i {
		width: 26px;
		height: 26px;
		display: inline-grid;
		place-items: center;
		border: 1px solid currentColor;
		border-radius: 4px;
		font-size: 0.72rem;
		transition: transform 260ms var(--motion-ease);
	}

	.news-card:hover .read-link i {
		transform: translateX(3px);
	}

	.news-sidebar {
		position: sticky;
		top: 104px;
		padding: 20px;
		border: 1px solid rgb(17 17 17 / 0.16) !important;
		border-left: 5px solid var(--primary) !important;
		border-radius: 8px !important;
		background:
			linear-gradient(rgb(17 17 17 / 0.028) 1px, transparent 1px),
			linear-gradient(90deg, rgb(17 17 17 / 0.028) 1px, transparent 1px),
			rgb(255 255 255 / 0.9) !important;
		background-size: 18px 18px, 18px 18px, auto !important;
		box-shadow: 0 16px 38px rgb(17 17 17 / 0.08) !important;
	}

	.news-sidebar h2 {
		margin: 0 0 10px;
		color: var(--ink);
		font-size: 1.05rem;
		font-weight: 900;
	}

	.news-sidebar a {
		display: grid;
		grid-template-columns: 22px 1fr;
		gap: 10px;
		align-items: center;
		min-height: 46px;
		padding: 10px 0;
		border-top: 1px solid rgb(17 17 17 / 0.12);
		color: var(--ink);
		font-weight: 900;
		transition:
			color 260ms var(--motion-ease),
			transform 260ms var(--motion-ease);
	}

	.news-sidebar a:hover {
		color: var(--primary);
		transform: translateX(4px);
	}

	@media (max-width: 980px) {
		.news-layout {
			grid-template-columns: 1fr;
		}

		.news-sidebar {
			position: static;
		}
	}

	@media (max-width: 720px) {
		.news-card {
			grid-template-columns: 1fr;
		}

		.news-image {
			min-height: auto;
			aspect-ratio: 16 / 9;
			border-right: 0;
			border-bottom: 1px solid rgb(17 17 17 / 0.14);
		}

		.news-card img {
			min-height: auto;
			aspect-ratio: 16 / 9;
		}

		.news-card.is-image-only,
		.news-card.is-image-only .news-image,
		.news-card.is-image-only img {
			min-height: auto;
		}
	}
</style>
