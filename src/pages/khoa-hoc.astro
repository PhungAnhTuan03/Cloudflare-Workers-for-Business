---
import Layout from "../layouts/Layout.astro";
import { courseCategories, courses, site } from "../lib/site-data";

const selectedField = Astro.url.searchParams.get("field") ?? "all";
const visibleCourses =
	selectedField === "all"
		? courses
		: courses.filter((course) => course.categoryId === selectedField);
const activeCategory = courseCategories.find((category) => category.id === selectedField);
---

<Layout
	title={`Khóa học công nghệ - ${site.name}`}
	description="Danh sách khóa học tin học văn phòng, AI, lập trình, thiết kế đồ họa, vẽ kỹ thuật, kế toán và Digital Marketing. Học thực hành, mentor theo sát, có chứng nhận hoàn thành."
>
	<section class="page-hero courses-hero">
		<div class="container page-hero-grid">
			<div>
				<p class="page-kicker"><i class="fa-solid fa-layer-group" aria-hidden="true"></i> Danh mục khóa học</p>
				<h1 class="page-title">Khóa học công nghệ cho từng mục tiêu nghề nghiệp.</h1>
				<p class="page-lead">
					Chọn khóa học theo năng lực hiện tại, lịch học, địa điểm và đầu ra mong muốn. Mỗi khóa có lộ trình,
					mentor, bài tập thực tế và chứng nhận hoàn thành.
				</p>
			</div>
			<div class="hero-summary card">
				<strong>{visibleCourses.length}</strong>
				<span>{activeCategory ? activeCategory.title : "khóa học đang mở lớp"}</span>
				<p>Khai giảng linh hoạt hằng tuần, có lớp online, offline và đào tạo theo nhóm doanh nghiệp.</p>
			</div>
		</div>
	</section>

	<section class="section tight">
		<div class="container">
			<div class="filter-bar" aria-label="Lọc khóa học">
				<a class:list={["filter-chip", selectedField === "all" && "is-active"]} href="/khoa-hoc">
					Tất cả
				</a>
				{courseCategories.map((category) => (
					<a
						class:list={["filter-chip", selectedField === category.id && "is-active"]}
						href={`/khoa-hoc?field=${category.id}`}
					>
						<i class={category.icon} aria-hidden="true"></i>
						{category.title}
					</a>
				))}
			</div>

			<div class="course-list-grid">
				{visibleCourses.map((course) => {
					const category = courseCategories.find((item) => item.id === course.categoryId);
					return (
						<a href={`/khoa-hoc/${course.slug}`} class="course-list-card">
							<div class="course-list-image">
								<img src={course.image} alt={course.title} loading="lazy" />
							</div>
							<div class="course-list-content">
								<div class="course-tags">
									<span>{category?.title}</span>
									<span><i class="fa-solid fa-star" aria-hidden="true"></i> {course.rating}</span>
								</div>
								<h2>{course.title}</h2>
								<p>{course.description}</p>
								<div class="course-facts">
									<span><i class="fa-regular fa-clock" aria-hidden="true"></i> {course.duration}</span>
									<span><i class="fa-solid fa-users" aria-hidden="true"></i> {course.students}</span>
									<span><i class="fa-solid fa-signal" aria-hidden="true"></i> {course.level}</span>
								</div>
								<div class="course-action">
									<strong>{course.price}</strong>
									<span class="btn btn-primary">Xem chi tiết</span>
								</div>
							</div>
						</a>
					);
				})}
			</div>
		</div>
	</section>
</Layout>

<style>
	.hero-summary {
		padding: 26px;
	}

	.hero-summary strong,
	.hero-summary span {
		display: block;
	}

	.hero-summary strong {
		color: var(--primary);
		font-size: clamp(3rem, 6vw, 4.5rem);
		line-height: 1;
	}

	.hero-summary span {
		margin-top: 8px;
		font-size: 1.15rem;
		font-weight: 900;
	}

	.hero-summary p {
		color: var(--muted);
	}

	.filter-bar {
		position: sticky;
		top: 84px;
		z-index: 5;
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-bottom: 28px;
		padding: 12px;
		border: 1px solid var(--line);
		border-radius: 20px;
		background: rgb(255 255 255 / 0.92);
		backdrop-filter: blur(16px);
		box-shadow: var(--shadow-sm);
	}

	.filter-chip {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 10px 13px;
		border: 1px solid transparent;
		border-radius: 12px;
		background: #fff;
		color: #334155;
		font-weight: 900;
		text-decoration: none;
		transition:
			background 180ms ease,
			color 180ms ease,
			border-color 180ms ease;
	}

	.filter-chip:hover,
	.filter-chip.is-active {
		border-color: rgb(37 99 235 / 0.22);
		background: rgb(37 99 235 / 0.08);
		color: var(--primary);
	}

	.course-list-grid {
		display: grid;
		gap: 18px;
	}

	.course-list-card {
		display: grid;
		grid-template-columns: 300px minmax(0, 1fr);
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: 24px;
		background: #fff;
		color: inherit;
		text-decoration: none;
		box-shadow: var(--shadow-xs);
		transition:
			transform 220ms ease,
			box-shadow 220ms ease,
			border-color 220ms ease;
	}

	.course-list-card:hover {
		transform: translateY(-4px);
		border-color: rgb(37 99 235 / 0.2);
		box-shadow: var(--shadow-md);
	}

	.course-list-image {
		overflow: hidden;
		min-height: 260px;
		background: var(--soft-blue);
	}

	.course-list-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 700ms ease;
	}

	.course-list-card:hover img {
		transform: scale(1.035);
	}

	.course-list-content {
		display: grid;
		align-content: center;
		padding: 26px;
	}

	.course-list-content h2 {
		margin: 14px 0 8px;
		font-size: clamp(1.55rem, 3vw, 2.15rem);
		line-height: 1.12;
	}

	.course-list-content p {
		max-width: 760px;
		color: var(--muted);
	}

	.course-tags,
	.course-facts,
	.course-action {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px;
	}

	.course-tags span,
	.course-facts span {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--muted);
		font-size: 0.9rem;
		font-weight: 900;
	}

	.course-tags span:first-child,
	.course-tags i {
		color: var(--primary);
	}

	.course-tags span:last-child i {
		color: var(--accent);
	}

	.course-action {
		justify-content: space-between;
		margin-top: 24px;
	}

	.course-action strong {
		color: var(--primary);
		font-size: 1.45rem;
	}

	@media (max-width: 860px) {
		.filter-bar {
			position: static;
		}

		.course-list-card {
			grid-template-columns: 1fr;
		}

		.course-list-image {
			min-height: 220px;
			aspect-ratio: 16 / 9;
		}
	}

	@media (max-width: 560px) {
		.course-action {
			display: grid;
		}
	}

	.course-list-grid {
		gap: 22px;
	}

	.course-list-card {
		position: relative;
	}

	.course-list-card::before {
		position: absolute;
		inset: 0 auto 0 0;
		width: 5px;
		content: "";
		background: var(--primary);
		opacity: 0;
		transition: opacity 260ms var(--motion-ease);
	}

	.course-list-card:hover::before {
		opacity: 1;
	}

	.course-list-card:nth-child(even) {
		grid-template-columns: minmax(0, 1fr) 300px;
	}

	.course-list-card:nth-child(even) .course-list-image {
		order: 2;
	}

	.course-list-image {
		position: relative;
	}

	.course-list-image::after {
		position: absolute;
		inset: 0;
		content: "";
		background:
			linear-gradient(180deg, transparent 46%, rgb(17 17 17 / 0.22)),
			repeating-linear-gradient(0deg, rgb(255 255 255 / 0.08) 0 1px, transparent 1px 5px);
		pointer-events: none;
	}

	@media (max-width: 860px) {
		.course-list-card:nth-child(even) {
			grid-template-columns: 1fr;
		}

		.course-list-card:nth-child(even) .course-list-image {
			order: initial;
		}
	}
</style>
