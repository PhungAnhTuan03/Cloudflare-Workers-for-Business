---
import { decodeSlug, getEmDashCollection, getTerm } from "emdash";
import { Image } from "emdash/ui";
import Layout from "../../layouts/Layout.astro";
import { site } from "../../lib/site-data";

const slug = decodeSlug(Astro.params.slug);
const term = slug ? await getTerm("tag", slug) : null;

if (!term) {
	return Astro.redirect("/404");
}

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	status: "published",
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
});

Astro.cache.set(cacheHint);
---

<Layout
	title={`Tag ${term.label} - ${site.name}`}
	description={`Các bài viết được gắn tag ${term.label}.`}
	canonical={`${site.url}/tag/${term.slug}`}
>
	<section class="page-hero">
		<div class="container">
			<span class="page-kicker">
				<i class="fa-solid fa-hashtag" aria-hidden="true"></i>
				Tag nội dung
			</span>
			<h1 class="page-title">#{term.label}</h1>
			<p class="page-lead">Có {posts.length} bài viết được gắn tag này.</p>
		</div>
	</section>

	<section class="section cms-section">
		<div class="container">
			{
				posts.length === 0 ? (
					<div class="empty-state">Chưa có bài viết nào với tag này.</div>
				) : (
					<div class="tag-grid">
						{posts.map((post) => (
							<a href={`/posts/${post.id}`} class="tag-card card">
								{post.data.featured_image ? (
									<div class="tag-image">
										<Image image={post.data.featured_image} />
									</div>
								) : (
									<div class="tag-image placeholder">
										<i class="fa-solid fa-newspaper" aria-hidden="true"></i>
									</div>
								)}
								<div>
									<h2>{post.data.title}</h2>
									{post.data.excerpt && <p>{post.data.excerpt}</p>}
								</div>
							</a>
						))}
					</div>
				)
			}
		</div>
	</section>
</Layout>

<style>
	.tag-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px;
	}

	.tag-card {
		overflow: hidden;
		display: grid;
		grid-template-columns: 180px minmax(0, 1fr);
		color: inherit;
		text-decoration: none;
	}

	.tag-image {
		min-height: 150px;
		background: var(--soft-blue);
	}

	.tag-image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.tag-image.placeholder {
		display: grid;
		place-items: center;
		color: var(--primary);
		font-size: 1.8rem;
	}

	.tag-card div:last-child {
		display: grid;
		align-content: center;
		gap: 8px;
		padding: 18px;
	}

	.tag-card h2 {
		margin: 0;
		font-size: 1.12rem;
		line-height: 1.35;
	}

	.tag-card p {
		margin: 0;
		color: var(--muted);
	}

	@media (max-width: 900px) {
		.tag-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 560px) {
		.tag-card {
			grid-template-columns: 1fr;
		}
	}
</style>
