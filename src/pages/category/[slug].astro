---
import { decodeSlug, getEmDashCollection, getTerm } from "emdash";
import Layout from "../../layouts/Layout.astro";
import { site } from "../../lib/site-data";

const slug = decodeSlug(Astro.params.slug);
const term = slug ? await getTerm("category", slug) : null;

if (!term) {
	return Astro.redirect("/404");
}

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	status: "published",
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
});

Astro.cache.set(cacheHint);
---

<Layout
	title={`Chủ đề ${term.label} - ${site.name}`}
	description={`Có ${posts.length} bài viết trong chủ đề ${term.label}.`}
	canonical={`${site.url}/category/${term.slug}`}
>
	<section class="page-hero">
		<div class="container">
			<span class="page-kicker">
				<i class="fa-solid fa-folder-open" aria-hidden="true"></i>
				Chủ đề
			</span>
			<h1 class="page-title">{term.label}</h1>
			<p class="page-lead">Có {posts.length} bài viết trong chủ đề này.</p>
		</div>
	</section>

	<section class="section cms-section">
		<div class="container">
			{
				posts.length === 0 ? (
					<div class="empty-state">Chưa có bài viết nào cho chủ đề này.</div>
				) : (
					<div class="topic-grid">
						{posts.map((post) => (
							<a href={`/posts/${post.id}`} class="topic-card card">
								<span>Blog</span>
								<h2 {...post.edit.title}>{post.data.title}</h2>
								{post.data.excerpt && <p {...post.edit.excerpt}>{post.data.excerpt}</p>}
								<strong>Xem chi tiết <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></strong>
							</a>
						))}
					</div>
				)
			}
		</div>
	</section>
</Layout>

<style>
	.topic-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 18px;
	}

	.topic-card {
		display: grid;
		gap: 10px;
		padding: 22px;
		color: inherit;
		text-decoration: none;
	}

	.topic-card span {
		color: var(--primary);
		font-size: 0.8rem;
		font-weight: 900;
		text-transform: uppercase;
	}

	.topic-card h2 {
		margin: 0;
		font-size: 1.16rem;
		line-height: 1.35;
	}

	.topic-card p {
		margin: 0;
		color: var(--muted);
	}

	.topic-card strong {
		color: var(--primary);
	}

	@media (max-width: 900px) {
		.topic-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 620px) {
		.topic-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
