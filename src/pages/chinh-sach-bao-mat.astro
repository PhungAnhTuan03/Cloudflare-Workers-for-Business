---
import Layout from "../layouts/Layout.astro";
import { site } from "../lib/site-data";
---

<Layout
	title={`Chính sách bảo mật - ${site.name}`}
	description="Chính sách bảo mật thông tin học viên, khách hàng và người dùng trên hệ thống Sao Việt Tech Academy."
	canonical={`${site.url}/chinh-sach-bao-mat`}
>
	<section class="page-hero policy-hero">
		<div class="container">
			<span class="page-kicker">
				<i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
				Thông tin cá nhân
			</span>
			<h1 class="page-title">Chính sách bảo mật</h1>
			<p class="page-lead">
				Trang này tóm tắt cách {site.name} thu thập, sử dụng và bảo vệ thông tin khi bạn đăng ký tư vấn, mua khóa học hoặc sử dụng dashboard học tập.
			</p>
		</div>
	</section>

	<section class="section policy-section">
		<div class="container policy-grid">
			<article class="policy-card card">
				<h2>Thông tin chúng tôi thu thập</h2>
				<p>Chúng tôi có thể ghi nhận họ tên, email, số điện thoại, nhu cầu học tập, khóa học quan tâm và thông tin giao dịch liên quan đến việc đăng ký học.</p>
			</article>
			<article class="policy-card card">
				<h2>Mục đích sử dụng</h2>
				<p>Thông tin được dùng để tư vấn lộ trình, tạo tài khoản học viên, xử lý đơn hàng, gửi thông báo khóa học và hỗ trợ trong quá trình học.</p>
			</article>
			<article class="policy-card card">
				<h2>Bảo vệ dữ liệu</h2>
				<p>Dữ liệu được giới hạn truy cập theo vai trò quản trị, giảng viên và học viên. Chúng tôi không bán thông tin cá nhân cho bên thứ ba.</p>
			</article>
			<article class="policy-card card">
				<h2>Yêu cầu hỗ trợ</h2>
				<p>Bạn có thể yêu cầu cập nhật, điều chỉnh hoặc xóa thông tin bằng cách liên hệ qua email {site.email} hoặc số điện thoại {site.phone}.</p>
			</article>
		</div>
	</section>
</Layout>

<style>
	.policy-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px;
	}

	.policy-card {
		padding: clamp(22px, 3vw, 30px);
		border-left: 5px solid var(--primary) !important;
	}

	.policy-card h2 {
		margin: 0 0 12px;
		font-size: clamp(1.35rem, 2.6vw, 2rem);
		line-height: 1.12;
	}

	.policy-card p {
		margin: 0;
		color: var(--muted);
	}

	@media (max-width: 760px) {
		.policy-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
