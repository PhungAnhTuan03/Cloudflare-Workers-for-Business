---
import ContactForm from "../components/ContactForm.astro";
import Layout from "../layouts/Layout.astro";
import {
	articles,
	courseCategories,
	courses,
	instructors,
	locations,
	reasons,
	roadmap,
	site,
	stats,
	testimonials,
} from "../lib/site-data";

const featuredCourses = courses.slice(0, 6);
const featuredInstructors = instructors.slice(0, 6);
const featuredLocations = locations.slice(0, 4);
const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "EducationalOrganization",
	name: site.name,
	url: Astro.url.origin,
	email: site.email,
	telephone: site.phone,
	address: {
		"@type": "PostalAddress",
		streetAddress: site.address,
		addressCountry: "VN",
	},
};
---

<Layout
	title={`${site.name} - Trung tâm đào tạo công nghệ thực chiến`}
	description="Học tin học văn phòng, AI, lập trình, thiết kế đồ họa, vẽ kỹ thuật, kế toán và Digital Marketing với mentor thực chiến, nhiều cơ sở và lộ trình rõ ràng."
	schema={organizationSchema}
>
	<section class="home-hero">
		<div class="container hero-shell">
			<div class="hero-copy">
				<p class="page-kicker"><i class="fa-solid fa-bolt" aria-hidden="true"></i> Học để dùng được trong công việc</p>
				<h1 class="page-title">Nâng cấp kỹ năng số bằng lộ trình rõ, lớp học gọn và mentor theo sát.</h1>
				<p class="page-lead">
					Sao Việt Tech Academy đào tạo thực hành cho người đi làm, sinh viên và doanh nghiệp:
					tin học văn phòng, AI, lập trình, thiết kế, vẽ kỹ thuật, kế toán và marketing số.
				</p>
				<div class="hero-actions">
					<a href="/dang-ky-tu-van" class="btn btn-primary">
						<i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
						Đăng ký học
					</a>
					<a href="#khoa-hoc" class="btn btn-secondary">
						<i class="fa-solid fa-layer-group" aria-hidden="true"></i>
						Xem khóa học
					</a>
				</div>
			</div>

			<div class="hero-media-panel">
				<img
					src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1200&q=82"
					alt="Lớp học công nghệ với học viên và mentor"
					loading="eager"
				/>
				<div class="hero-proof">
					<strong>13 cơ sở</strong>
					<span>TP. Hồ Chí Minh, Bình Dương, Đồng Nai và Vũng Tàu</span>
				</div>
			</div>

			<form class="course-finder" action="/marketplace" method="get" role="search">
				<div class="finder-field finder-main">
					<label for="home-search">Tìm khóa học</label>
					<div>
						<i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
						<input id="home-search" name="q" placeholder="Nhập kỹ năng, khóa học hoặc giảng viên..." />
					</div>
				</div>
				<div class="finder-field">
					<label for="home-category">Danh mục</label>
					<select id="home-category" name="field">
						<option value="">Tất cả</option>
						{courseCategories.map((category) => <option value={category.id}>{category.title}</option>)}
					</select>
				</div>
				<button class="btn btn-primary" type="submit">
					<i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
					Tìm lộ trình
				</button>
			</form>
		</div>
	</section>

	<section class="stats-band">
		<div class="container stats-grid">
			{stats.map((item) => (
				<div class="stat-card">
					<strong>{item.value}</strong>
					<span>{item.label}</span>
				</div>
			))}
		</div>
	</section>

	<section id="gioi-thieu" class="section about-section">
		<div class="container about-grid">
			<div class="about-media">
				<img
					src="https://images.unsplash.com/photo-1571260899304-425eee4c7efc?auto=format&fit=crop&w=1200&q=82"
					alt="Không gian học công nghệ hiện đại"
					loading="lazy"
				/>
			</div>
			<div class="about-copy">
				<p class="section-eyebrow">Về Sao Việt Tech Academy</p>
				<h2 class="section-title">Một trung tâm học công nghệ thực tế, dễ bắt đầu và dễ theo đuổi.</h2>
				<p class="section-lead">
					Chương trình được thiết kế cho người cần dùng kỹ năng ngay trong công việc. Mỗi khóa học có bài tập,
					mentor review, đầu ra rõ ràng và hướng dẫn chọn cơ sở/lịch học phù hợp.
				</p>
				<div class="about-points">
					{reasons.map((reason) => (
						<div>
							<i class={reason.icon} aria-hidden="true"></i>
							<strong>{reason.title}</strong>
							<span>{reason.description}</span>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<section class="section category-section">
		<div class="container">
			<div class="section-head">
				<div>
					<p class="section-eyebrow">Danh mục đào tạo</p>
					<h2 class="section-title">Chọn đúng kỹ năng cho mục tiêu tiếp theo.</h2>
				</div>
				<a href="#khoa-hoc" class="btn btn-ghost">Xem khóa học bên dưới</a>
			</div>
			<div class="category-grid">
				{courseCategories.map((category) => (
					<a href={category.href} class="category-card">
						<div class="category-icon" style={`--accent-color: ${category.accent}`}>
							<i class={category.icon} aria-hidden="true"></i>
						</div>
						<h3>{category.title}</h3>
						<p>{category.description}</p>
						<span>Xem khóa học <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
					</a>
				))}
			</div>
		</div>
	</section>

	<section id="khoa-hoc" class="section featured-section">
		<div class="container">
			<div class="section-head center">
				<p class="section-eyebrow">Khóa học nổi bật</p>
				<h2 class="section-title">Khóa học đã được đưa thẳng lên trang chủ để bạn chọn nhanh hơn.</h2>
				<p class="section-lead">
					Không cần mở thêm mục “Khóa học” trên header. Bạn có thể tìm, so sánh và vào marketplace ngay từ đây.
				</p>
			</div>
			<div class="course-grid">
				{featuredCourses.map((course) => {
					const category = courseCategories.find((item) => item.id === course.categoryId);
					return (
						<a href={`/khoa-hoc/${course.slug}`} class="course-card">
							<div class="course-image">
								<img src={course.image} alt={course.title} loading="lazy" />
							</div>
							<div class="course-body">
								<div class="course-meta">
									<span>{category?.title}</span>
									<span><i class="fa-solid fa-star" aria-hidden="true"></i> {course.rating}</span>
								</div>
								<h3>{course.title}</h3>
								<p>{course.description}</p>
								<div class="course-bottom">
									<strong>{course.price}</strong>
									<span>{course.duration}</span>
								</div>
							</div>
						</a>
					);
				})}
			</div>
			<div class="home-course-actions">
				<a href="/marketplace" class="btn btn-primary">
					<i class="fa-solid fa-store" aria-hidden="true"></i>
					Xem marketplace khóa học
				</a>
				<a href="/dang-ky-tu-van" class="btn btn-secondary">Nhận tư vấn lộ trình</a>
			</div>
		</div>
	</section>

	<section class="section roadmap-section">
		<div class="container roadmap-grid">
			<div>
				<p class="section-eyebrow">Lộ trình học</p>
				<h2 class="section-title">Từ tư vấn đầu vào đến sản phẩm cuối khóa.</h2>
				<p class="section-lead">
					Quy trình học được giữ gọn: xác định mục tiêu, học nền tảng, thực hành có mentor và hoàn thiện đầu ra.
				</p>
			</div>
			<div class="timeline">
				{roadmap.map((item) => (
					<div class="timeline-item">
						<span>{item.step}</span>
						<div>
							<h3>{item.title}</h3>
							<p>{item.description}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="section mentor-section" id="giang-vien">
		<div class="container">
			<div class="section-head">
				<div>
					<p class="section-eyebrow">Đội ngũ giảng viên</p>
					<h2 class="section-title">Học cùng mentor có kinh nghiệm triển khai thực tế.</h2>
					<p class="section-lead">
						Giảng viên hướng dẫn quy trình làm việc, review sản phẩm và giúp học viên hiểu tiêu chuẩn đầu ra.
					</p>
				</div>
				<a href="/dang-ky-tu-van" class="btn btn-secondary">Gặp mentor tư vấn</a>
			</div>
			<div class="mentor-grid">
				{featuredInstructors.map((instructor) => (
					<article class="mentor-card">
						<img src={instructor.image} alt={instructor.name} loading="lazy" />
						<div>
							<span>{instructor.experience}</span>
							<h3>{instructor.name}</h3>
							<p class="mentor-role">{instructor.role}</p>
							<p>{instructor.bio}</p>
							<div class="mentor-skills">
								{instructor.skills.slice(0, 3).map((skill) => <small>{skill}</small>)}
							</div>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section proof-section">
		<div class="container proof-grid">
			<div class="testimonial-panel">
				<p class="section-eyebrow">Feedback học viên</p>
				<h2 class="section-title">Học xong dùng được ngay trong công việc.</h2>
				<div class="testimonial-track">
					{testimonials.map((item) => (
						<figure class="testimonial-card">
							<div class="rating"><i class="fa-solid fa-star" aria-hidden="true"></i> {item.rating}</div>
							<blockquote>{item.content}</blockquote>
							<figcaption>
								<strong>{item.name}</strong>
								<span>{item.role}</span>
							</figcaption>
						</figure>
					))}
				</div>
			</div>
			<div class="branch-panel">
				<p class="section-eyebrow">Cơ sở gần bạn</p>
				<h2>Học tại trung tâm hoặc nhận tư vấn online.</h2>
				<div class="branch-list">
					{featuredLocations.map((location) => (
						<a href="/lien-he">
							<strong>{location.name}</strong>
							<span>{location.address}</span>
						</a>
					))}
				</div>
			</div>
		</div>
	</section>

	<section class="section article-section">
		<div class="container">
			<div class="section-head">
				<div>
					<p class="section-eyebrow">Tin tức và hướng dẫn</p>
					<h2 class="section-title">Cập nhật xu hướng học tập và công nghệ.</h2>
				</div>
				<a href="/tin-tuc" class="btn btn-ghost">Tất cả bài viết</a>
			</div>
			<div class="article-grid">
				{articles.map((article) => (
					<a href={`/tin-tuc/${article.slug}`} class="article-card">
						<img src={article.image} alt={article.title} loading="lazy" />
						<div>
							<span>{article.category}</span>
							<span>{article.date}</span>
							<h3>{article.title}</h3>
							<p>{article.description}</p>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="section consult-section" id="tu-van">
		<div class="container consult-grid">
			<div>
				<p class="section-eyebrow">Đăng ký tư vấn</p>
				<h2 class="section-title">Chưa biết nên bắt đầu từ đâu? Để đội ngũ tư vấn gợi ý lộ trình.</h2>
				<p class="section-lead">
					Gửi thông tin, chúng tôi sẽ liên hệ để đề xuất khóa học, cơ sở, lịch học và học phí phù hợp.
				</p>
			</div>
			<div class="consult-form card">
				<ContactForm
					formId="home-consult-form"
					submitLabel="Gửi thông tin tư vấn"
					defaultSubject="Tư vấn khóa học"
					defaultMessage="Tôi muốn được tư vấn lộ trình học phù hợp."
				/>
			</div>
		</div>
	</section>
</Layout>

<style>
	.home-hero {
		position: relative;
		overflow: hidden;
		padding: clamp(58px, 8vw, 96px) 0 34px;
		background:
			radial-gradient(circle at 76% 8%, rgb(96 165 250 / 0.2), transparent 28rem),
			linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
	}

	.hero-shell {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(340px, 0.95fr);
		gap: clamp(28px, 5vw, 56px);
		align-items: center;
	}

	.hero-copy {
		min-width: 0;
	}

	.home-hero .page-title {
		max-width: 880px;
		font-size: clamp(2.45rem, 5.3vw, 4.75rem);
		line-height: 1.02;
	}

	.home-hero .page-lead {
		max-width: 690px;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 28px;
	}

	.hero-media-panel {
		position: relative;
		overflow: hidden;
		min-height: 420px;
		border: 1px solid rgb(37 99 235 / 0.12);
		border-radius: 28px;
		background: #fff;
		box-shadow: var(--shadow-blue);
	}

	.hero-media-panel::after {
		position: absolute;
		inset: 0;
		content: "";
		background: linear-gradient(180deg, transparent 48%, rgb(15 23 42 / 0.18));
		pointer-events: none;
	}

	.hero-media-panel img {
		width: 100%;
		height: 100%;
		min-height: 420px;
		object-fit: cover;
		filter: saturate(0.92) contrast(1.02);
		transition: transform 700ms ease;
	}

	.hero-media-panel:hover img {
		transform: scale(1.035);
	}

	.hero-proof {
		position: absolute;
		right: 18px;
		bottom: 18px;
		z-index: 1;
		width: min(280px, calc(100% - 36px));
		padding: 16px;
		border: 1px solid rgb(255 255 255 / 0.64);
		border-radius: 18px;
		background: rgb(255 255 255 / 0.92);
		box-shadow: var(--shadow-sm);
	}

	.hero-proof strong,
	.hero-proof span {
		display: block;
	}

	.hero-proof strong {
		color: var(--primary);
		font-size: 1.4rem;
		line-height: 1.1;
	}

	.hero-proof span {
		margin-top: 4px;
		color: var(--muted);
		font-size: 0.92rem;
		font-weight: 700;
	}

	.course-finder {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: minmax(260px, 1fr) minmax(180px, 260px) auto;
		gap: 12px;
		align-items: end;
		margin-top: 8px;
		padding: 16px;
		border: 1px solid var(--line);
		border-radius: 22px;
		background: rgb(255 255 255 / 0.94);
		box-shadow: var(--shadow-md);
	}

	.finder-field {
		display: grid;
		gap: 7px;
	}

	.finder-field label {
		color: var(--ink-soft);
		font-size: 0.86rem;
		font-weight: 900;
	}

	.finder-field > div {
		display: flex;
		align-items: center;
		gap: 10px;
		min-height: 48px;
		padding: 0 14px;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: #fff;
		color: var(--muted);
	}

	.finder-field input,
	.finder-field select {
		width: 100%;
		min-height: 48px;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: #fff;
		color: var(--ink);
		padding: 0 14px;
		outline: none;
	}

	.finder-field > div input {
		min-height: auto;
		padding: 0;
		border: 0;
	}

	.stats-band {
		padding: 22px 0;
		border-block: 1px solid rgb(37 99 235 / 0.08);
		background: #fff;
	}

	.stats-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 14px;
	}

	.stat-card {
		padding: 18px;
		border: 1px solid var(--line);
		border-radius: 18px;
		background: linear-gradient(180deg, #fff, #f8fbff);
	}

	.stat-card strong,
	.stat-card span {
		display: block;
	}

	.stat-card strong {
		color: var(--primary);
		font-size: clamp(1.8rem, 4vw, 2.8rem);
		line-height: 1;
	}

	.stat-card span {
		margin-top: 8px;
		color: var(--muted);
		font-weight: 800;
	}

	.about-section,
	.mentor-section,
	.article-section {
		background: #fff;
	}

	.about-grid,
	.roadmap-grid,
	.consult-grid,
	.proof-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
		gap: clamp(30px, 5vw, 54px);
		align-items: center;
	}

	.about-media {
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: 26px;
		background: var(--soft-blue);
		box-shadow: var(--shadow-sm);
		aspect-ratio: 4 / 3;
	}

	.about-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.about-points {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 14px;
		margin-top: 26px;
	}

	.about-points div,
	.timeline-item,
	.branch-panel {
		border: 1px solid var(--line);
		border-radius: 18px;
		background: #fff;
		box-shadow: var(--shadow-xs);
	}

	.about-points div {
		display: grid;
		gap: 7px;
		padding: 18px;
	}

	.about-points i {
		color: var(--primary);
		font-size: 1.35rem;
	}

	.about-points strong {
		color: var(--ink);
	}

	.about-points span {
		color: var(--muted);
		font-size: 0.92rem;
	}

	.category-section,
	.featured-section,
	.roadmap-section,
	.proof-section,
	.consult-section {
		background: linear-gradient(180deg, #f8fafc, #ffffff);
	}

	.category-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		grid-auto-flow: dense;
		gap: 16px;
	}

	.category-card {
		min-height: 220px;
		display: grid;
		align-content: start;
		padding: 22px;
		border: 1px solid var(--line);
		border-radius: 22px;
		background: #fff;
		color: inherit;
		text-decoration: none;
		box-shadow: var(--shadow-xs);
		transition:
			transform 220ms ease,
			box-shadow 220ms ease,
			border-color 220ms ease;
	}

	.category-card:hover,
	.course-card:hover,
	.article-card:hover,
	.mentor-card:hover {
		transform: translateY(-4px);
		border-color: rgb(37 99 235 / 0.2);
		box-shadow: var(--shadow-md);
	}

	.category-icon {
		width: 52px;
		height: 52px;
		display: grid;
		place-items: center;
		border-radius: 16px;
		background: color-mix(in srgb, var(--accent-color) 12%, white);
		color: var(--accent-color);
	}

	.category-card h3,
	.course-card h3,
	.mentor-card h3,
	.article-card h3 {
		margin: 18px 0 8px;
		line-height: 1.2;
	}

	.category-card p,
	.course-card p,
	.mentor-card p,
	.article-card p,
	.timeline-item p {
		color: var(--muted);
	}

	.category-card span {
		margin-top: auto;
		color: var(--primary);
		font-weight: 900;
	}

	.course-grid,
	.mentor-grid,
	.article-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 18px;
	}

	.course-card,
	.mentor-card,
	.article-card {
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: 22px;
		background: #fff;
		color: inherit;
		text-decoration: none;
		box-shadow: var(--shadow-xs);
		transition:
			transform 220ms ease,
			box-shadow 220ms ease,
			border-color 220ms ease;
	}

	.course-card {
